---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Marquee from '../../components/Marquee.astro';
import CTA from '../../components/CTA.astro';
import Credit from '../../components/Credit.astro';

const faqs = [
  ['Do you offer bilingual DJs and MCs?', 'Yes. Our DJs host in English and Spanish and read multicultural crowds with ease — keeping every generation, and both sides of the family, on the dance floor.'],
  ['Can we bundle the DJ, photo booth, and lighting together?', 'Absolutely — that’s the whole point. Booking everything with one team means one timeline, one point of contact, and a night that flows seamlessly from ceremony to last dance.'],
  ['How far in advance should we book?', 'We take a limited number of weddings each weekend to keep our quality high, so popular dates book up fast. Check your date as early as you can to lock it in.'],
  ['What areas do you serve?', 'All of South Florida — Miami-Dade, Broward, Palm Beach, and the Florida Keys.'],
  ['How do we get a price?', 'Tell us your date and your vision and we’ll send transparent pricing and packages. DJ services start at $2,500.'],
];
---
<Base title="Wedding Entertainment Services in Miami & South Florida | Xpress Entertainment" description="Wedding DJs, MCs, photo booths, lighting, cold sparks & content creation — all from one award-winning South Florida team. Serving Miami, Fort Lauderdale & Palm Beach.">

  <Hero
    eyebrow="Miami · Fort Lauderdale · Palm Beach"
    titleHtml={`Weddings People<br>Don't Stop<br><span class="serif-accent" style="font-style:italic">Talking About</span>`}
    sub="From the first note of your ceremony to the last song of the night, we bring the DJs, MCs, photo booths, and production that turn a beautiful wedding into an unforgettable one — all handled by one team."
    image="/images/heroes/services-hero.jpg"
    alt="Bride and groom dancing with guests at their Jupiter, Florida wedding reception"
    ctaText="Check Your Date"
    creditName="Jupiter Wedding Photo"
    creditHref="https://www.jupiterweddingphoto.com/"
  />

  <Marquee items={["Bilingual","Open-Format","Cinematic","Stress-Free","Award-Winning"]} variant="alt" />

  <!-- STAT BAND -->
  <section class="bg-purple" style="padding-block:50px;">
    <div class="wrap">
      <div class="stats" style="border:none; padding-top:0;">
        <div class="stat reveal"><div class="num">150+</div><div class="label" style="color:#fff;">Weddings every year</div></div>
        <div class="stat reveal d1"><div class="num">8+ yrs</div><div class="label" style="color:#fff;">Never missed an event</div></div>
        <div class="stat reveal d2"><div class="num">Bilingual</div><div class="label" style="color:#fff;">DJs & MCs who speak your crowd</div></div>
        <div class="stat reveal d3"><div class="num" style="font-size:clamp(1.8rem,3.4vw,2.6rem);">Award-Winning</div><div class="label" style="color:#fff;">WeddingWire Best of Weddings</div></div>
      </div>
    </div>
  </section>

  <!-- PROMISE -->
  <section class="pad bg-ink">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow">Why it matters</span><h2 class="h-xl">Anyone Can Press Play. We Read the Room.</h2><p class="lead" style="margin-inline:auto;">The difference between a nice wedding and an unforgettable one isn’t the playlist — it’s the timing, the energy, and the person behind the booth who knows exactly when to build a moment and when to let it breathe. We plan with you, coordinate with your vendors, and run your night start to finish, so the only thing you have to do is enjoy it.</p></div>
    </div>
  </section>

  <!-- SIGNATURE ROWS -->
  <section class="pad bg-deep">
    <div class="wrap">
      <div class="srow reveal">
        <figure class="media-fig"><div class="srow-media"><img src="/images/drew-newlyweds-dance-floor.jpg" alt="DJ Drew Segura dancing with newlyweds on the dance floor at Vista Lago Ballroom" /></div><Credit variant="caption" align="left" name="E + B Photography and Film Co." href="https://www.ebphotographyandfilmco.com/" /></figure>
        <div><span class="idx">THE SOUND</span><h3>DJs & MCs Who Run the Whole Night</h3><p>Bilingual, open-format, and impossible to ignore. Your DJ reads the floor in real time and doubles as the MC who guides every introduction, toast, and transition — so the energy never drops and you never feel rushed.</p><a href="/services/djs" class="textlink">Meet our DJs →</a></div>
      </div>
      <div class="srow rev reveal">
        <figure class="media-fig"><div class="srow-media"><img src="/images/photobooths-miami-broward.jpg" alt="Wedding guests enjoying the Xpress Entertainment photo booth at a Miami reception" /></div><Credit variant="caption" name="Jupiter Wedding Photo" href="https://www.jupiterweddingphoto.com/" /></figure>
        <div><span class="idx">THE KEEPSAKE</span><h3>Photo Booths That Become the Party</h3><p>Our Lux and 360 booths pull guests off their seats and send them home with something real — instant custom prints, shareable videos, and an on-site attendant making sure every group shot lands.</p><a href="/south-florida-photo-booth-rental" class="textlink">See the booths →</a></div>
      </div>
      <div class="srow reveal">
        <figure class="media-fig"><div class="srow-media"><img src="/images/sax-live-dance-floor.jpg" alt="Live saxophone player performing with Xpress Entertainment on the wedding dance floor" /></div><Credit variant="caption" align="left" name="Jupiter Wedding Photo" href="https://www.jupiterweddingphoto.com/" /></figure>
        <div><span class="idx">THE WOW</span><h3>Moments That Look Like a Movie</h3><p>Cold sparks raining over your grand entrance. Dancing on the clouds for your first dance. CO2 blasts when the beat drops. The cinematic touches that make your photographer’s job easy and your guests’ jaws drop.</p><a href="/epic-extras-1" class="textlink">Explore Epic Extras →</a></div>
      </div>
    </div>
  </section>

  <!-- EVERY DETAIL ONE TEAM -->
  <section class="pad bg-ink">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow">Complete the experience</span><h2 class="h-xl">Every Detail, One Team</h2></div>
      <div class="cards">
        <a class="card reveal" href="/epic-extras-1/lighting"><img src="/images/wedding-monogram.jpg" alt="Custom wedding monogram with the couple's initials projected on the venue wall" /><div class="card-body"><h3 style="font-size:1.4rem;">Lighting & Monogram</h3><p>Uplighting, intelligent dance-floor lighting, and a custom monogram that transforms your venue after dark.</p></div></a>
        <a class="card reveal d1" href="/wedding-content-creator"><img src="/images/wedding-content-creator.jpg" alt="Wedding content creator capturing behind-the-scenes moments live at a reception" /><div class="card-body"><h3 style="font-size:1.4rem;">Wedding Content Creator</h3><p>Reels and photos captured and delivered while your party is still going — content you’ll actually want to post.</p></div></a>
        <a class="card reveal d2" href="/vibo"><img src="/images/vibo-dj-app.jpg" alt="Vibo DJ app for planning every detail of your wedding entertainment" /><div class="card-body"><h3 style="font-size:1.4rem;">Vibo Planning App</h3><p>Plan every song and moment from your phone with Vibo, our stress-free music planning app built into your booking.</p></div></a>
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF -->
  <section class="pad bg-purple">
    <div class="wrap" style="max-width:820px; text-align:center;">
      <span class="eyebrow light reveal">Trusted</span>
      <h2 class="h-xl reveal d1" style="margin:14px 0 18px; color:#fff;">South Florida Couples Trust Us With Their Biggest Night</h2>
      <p class="lead reveal d2" style="margin-inline:auto; color:#f6f2ff;">150+ weddings a year. Two-time WeddingWire Best of Weddings winner. Hundreds of five-star reviews from couples across Miami, Fort Lauderdale, and Palm Beach.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="pad bg-light">
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow">Good to know</span><h2 class="h-xl">Questions Couples Ask Us</h2></div>
      <div style="max-width:820px;">
        {faqs.map(([q, a], i) => (
          <div class={`reveal ${i % 2 ? 'd1' : ''}`} style="padding:24px 0; border-bottom:1px solid rgba(0,0,0,0.1);">
            <h3 style="font-size:1.4rem; color:var(--purple); margin-bottom:8px;">{q}</h3>
            <p style="color:#5a4f6e; line-height:1.8;">{a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA titleHtml={`Let's Make Your Wedding<br>the One Everyone Remembers`} text="Tell us your date. We'll show you how effortless an unforgettable night can feel." />
</Base>
