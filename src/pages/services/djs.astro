---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import Credit from '../../components/Credit.astro';
---
<Base title="Wedding DJs in South Florida | Xpress Entertainment" description="Your go-to source for the best wedding DJs in South Florida. Professional, bilingual DJs from diverse backgrounds, committed to making your wedding extraordinary.">

  <Hero
    eyebrow="Let's dance"
    titleHtml={`Wedding DJs in<br>South Florida`}
    sub="This is what we do."
    image="/images/heroes/dj-services-hero.jpg"
    alt="Two wedding guests having fun in the middle of a packed dance floor"
    ctaText="Check Availability"
    creditName="Romina Raggio Photography"
    creditHref="https://rominaraggio.com/"
  />

  <section class="pad bg-ink">
    <div class="wrap" style="max-width:880px;">
      <p class="lead reveal">Welcome to Xpress Entertainment, your go-to source for the best wedding DJs in South Florida! We understand that your wedding day is one of the most important moments of your life, and we’re here to make sure it’s filled with unforgettable music and joyous memories. With a team of professional, bilingual DJs from diverse backgrounds and a deep passion for music, we are committed to making your wedding celebration extraordinary.</p>
    </div>
  </section>

  <section class="pad bg-deep">
    <div class="wrap">
      <div class="split">
        <figure class="media-fig reveal">
          <div class="media"><img src="/images/dj-drew-djing.jpg" alt="Drew Segura DJing a wedding, mixing live" /></div>
          <Credit variant="caption" name="Sid Rashlich" href="https://photovsl.com/" />
        </figure>
        <div class="reveal d1">
          <span class="eyebrow light">Why choose us</span>
          <h2 class="h-lg" style="margin:14px 0 18px;">Why Choose Xpress Entertainment for Your Wedding?</h2>
          <p class="lead">At Xpress Entertainment, we specialize in providing top-notch wedding DJ services tailored to your unique style and preferences. Our experienced DJs are not just music experts; they are masters of creating the perfect atmosphere that keeps your guests dancing all night long. Whether you’re looking for a sophisticated and elegant vibe or a high-energy dance party, we’ve got you covered.</p>
          <p class="lead" style="margin-top:14px;">We pride ourselves on having a team of DJs who can cater to both English and Spanish-speaking guests. Our DJs come from diverse cultural backgrounds, allowing us to seamlessly blend various musical genres and styles to match your wedding theme and audience. From classic love songs to the latest dance hits, we ensure that every moment of your wedding day is perfectly soundtracked.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- VIBO -->
  <section class="pad bg-ink">
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow">Communication is key</span><h2 class="h-xl">Introducing the Vibo DJ App</h2><p class="lead">At Xpress Entertainment, we take your wedding experience to the next level with our exclusive event management app. This user-friendly app is designed to make planning your wedding music and timeline seamless and interactive, putting you in complete control.</p></div>
      <div class="values">
        <div class="value reveal" style="border-color:rgba(255,255,255,0.14); color:#fff;"><p style="color:#d9d0ec;">🎵 Manage Wedding Details</p><p style="color:#d9d0ec;">📅 Manage Wedding Timeline & Music</p></div>
        <div class="value reveal d1" style="border-color:rgba(255,255,255,0.14); color:#fff;"><p style="color:#d9d0ec;">❓ Answer Your DJs Questions</p><p style="color:#d9d0ec;">👥 Invite Guests to Help Add Music</p></div>
        <div class="value reveal d2" style="border-color:rgba(255,255,255,0.14); color:#fff;"><p style="color:#d9d0ec;">🗂️ Manage Sections within your timeline</p><p style="color:#d9d0ec;">🎶 Import Music / playlist from Spotify, Apple Music, and More</p></div>
      </div>
      <p class="lead reveal" style="margin-top:30px; max-width:820px;">The Xpress Entertainment app makes planning your wedding music simple, collaborative, and enjoyable. With all these tools at your fingertips, you can focus on enjoying your big day, knowing that every detail has been expertly handled.</p>
    </div>
  </section>

  <!-- LOCATIONS -->
  <section class="pad bg-light">
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow">Locations Served</span><h2 class="h-xl">Across South Florida.</h2></div>
      <div class="values">
        <div class="value reveal"><h3>Broward</h3></div>
        <div class="value reveal d1"><h3>Miami</h3></div>
        <div class="value reveal d2"><h3>West Palm</h3></div>
      </div>
    </div>
  </section>

  <!-- TRUSTED BRANDS -->
  <section class="pad bg-deep">
    <div class="wrap" style="max-width:880px; text-align:center;">
      <span class="eyebrow light reveal">We use trusted brands</span>
      <h2 class="h-lg reveal d1" style="margin:14px 0 18px;">Flawless, every time.</h2>
      <p class="lead reveal d2" style="margin-inline:auto;">At Xpress Entertainment, we prioritize flawless wedding experiences and exclusively rely on trusted and renowned brands for our equipment. By partnering with these established brands, we ensure the seamless execution of weddings, leaving no room for disruptions. Our commitment to using trusted equipment brands underscores our dedication to making each wedding a memorable and smoothly orchestrated occasion.</p>
    </div>
  </section>

  <CTA eyebrow="Lock your date" titleHtml={`Book your<br>DJ.`} />
</Base>
