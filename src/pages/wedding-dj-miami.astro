---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
---
<Base title="Wedding DJ Miami | Bilingual DJ & MC — Xpress Entertainment" description="Miami's go-to bilingual wedding DJ. Latin & open-format experts. 100+ Miami weddings/year. Starting at $2,500. See packages & check availability.">

  <Hero
    eyebrow="Miami, FL"
    titleHtml={`Your Miami<br>wedding DJ.`}
    sub="High-energy, bilingual, and always on point. From the ceremony to the last dance, Xpress Entertainment brings the music, energy, and professionalism your Miami wedding deserves."
    image="https://xpressdjs.com/wp-content/uploads/2025/04/xpress-djs-entertainment-party-wedding.png"
    alt="Miami wedding DJ"
    ctaText="Check Your Date"
  />

  <section class="pad bg-ink">
    <div class="wrap">
      <div class="split">
        <div class="media reveal"><img src="https://xpressdjs.com/wp-content/uploads/2024/09/Kirsten_Quinten_Wedding-944.jpg" alt="Miami wedding reception" /></div>
        <div class="reveal d1">
          <span class="eyebrow">Built for Miami weddings</span>
          <h2 class="h-lg" style="margin:14px 0 20px;">A DJ who speaks your crowd.</h2>
          <p class="lead">We've helped hundreds of couples across Miami celebrate — blending Reggaeton, Latin, Top 40, and open-format so every generation and both sides of the family stay on the dance floor. Bilingual MC included.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="pad bg-light">
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow">Why Miami couples book us</span><h2 class="h-xl">Local. Bilingual. Unforgettable.</h2></div>
      <div class="values">
        <div class="value reveal"><div class="vnum">01</div><h3>Bilingual DJ & MC</h3><p>English & Spanish hosting that keeps Miami's multicultural crowds dancing all night.</p></div>
        <div class="value reveal d1"><div class="vnum">02</div><h3>Every Miami Venue</h3><p>From beachfront ceremonies to luxury ballrooms — we know how to work the room.</p></div>
        <div class="value reveal d2"><div class="vnum">03</div><h3>From $2,500</h3><p>Transparent pricing with photo booths, lighting, and epic extras to complete the night.</p></div>
      </div>
    </div>
  </section>

  <CTA eyebrow="Miami weddings" titleHtml={`Book your Miami<br>wedding DJ.`} />
</Base>
