---
import Base from '../layouts/Base.astro';
import Credit from '../components/Credit.astro';

const CONSENT_TEXT = "I consent to receive SMS notifications from Xpress Entertainment regarding my inquiries, bookings, and promotional offers. Message and data rates may apply. I understand that I can opt out at any time by replying 'STOP' to any message.";

// Cloudflare Turnstile anti-spam. Set PUBLIC_TURNSTILE_SITE_KEY in the
// Cloudflare Pages build env vars to switch it on; until then the form
// works with the honeypot only.
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';

const eventTypeOther = [
  'Banquet','Bar Mitzvah','Bat Mitzvah','Birthday Party','Class Reunion','Community Celebration',
  'Company Holiday Party','Family Reunion','Graduation Celebration','Night Club / Bar Dance',
  'Private Party','Quinceanera','PA / Sound Reinforcement','School Dance','Sweet 16',
  'Wedding Anniversary','Other / Not Listed',
];
const relations = ["I'm A Bride!","I'm a Groom!","I'm a Family Member","I'm a Wedding Planner / Coordinator"];

const BOOKING_URL = 'https://api.leadconnectorhq.com/widget/booking/VusY7T1D0DLoYTQ1uNJ5';

const leadCfg = {
  locale: 'en',
  consentText: CONSENT_TEXT,
  turnstileKey: TURNSTILE_SITE_KEY,
  bookingUrl: BOOKING_URL,
  i18n: {
    next: 'Next',
    submit: 'Submit',
    sending: 'Saving…',
    calendarTitle: 'Book your Xpress Entertainment video consultation',
    summary: 'Please fix the highlighted field:',
    errors: {
      required: 'Please fill in this field.',
      invalid: 'Please check this field.',
      invalid_email: 'Enter a valid email address, like name@example.com.',
      invalid_phone: 'Enter a 10-digit US phone number, or an international number starting with +.',
      invalid_choice: 'Please choose one of the options.',
      invalid_date: 'Enter a valid event date.',
      past_date: "Your event date can't be in the past. Please pick an upcoming date.",
      date_too_far: 'Please pick a date within the next 5 years, or call/text us at 954-833-1196.',
      invalid_time: 'Enter a time with AM or PM, like 6:00 PM.',
      invalid_guests: 'Enter an estimated guest count between 1 and 5,000.',
      too_long: "That's a bit long. Please shorten it.",
      consent_required_for_sms: 'To be contacted by text, check the SMS consent box, or choose "Email me" instead.',
    },
    codes: {
      antispam: 'Please complete the anti-spam check just above the buttons, then press Submit again.',
      antispam_unavailable: "We couldn't run the anti-spam check. Your answers are still here. Please press Submit again in a moment.",
      in_progress: 'Your inquiry is still being saved. Please wait a moment before trying again.',
      save_failed: "We couldn't confirm your inquiry just now. Your answers are still here. Please press Submit again, or call/text us at 954-833-1196.",
      not_configured: "We couldn't save your inquiry just now. Please call or text us at 954-833-1196.",
      not_ready: "Online inquiries are temporarily unavailable. Your answers are still here. Please try again shortly, or call/text us at 954-833-1196.",
      network: 'Connection problem. Your answers are still here. Check your connection and press Submit again, or call/text 954-833-1196.',
      bad_request: 'Something went wrong. Your answers are still here. Please press Submit again or call/text 954-833-1196.',
      generic: 'Something went wrong. Your answers are still here. Please press Submit again or call/text 954-833-1196.',
    },
  },
};
---
<Base title="Check Availability | Xpress Entertainment — South Florida Wedding DJs" description="So, you want to know if we're free on your date? Fill out the form and a team member will reach out to see if Xpress Entertainment is available for your celebration." hideChat>

  <header class="hero" style="min-height:62svh;">
    <div class="hero-bg"><img src="/images/heroes/check-availability-hero.jpg" alt="Wedding guests enjoying themselves on the dance floor" /></div>
    <Credit variant="overlay" name="Leo Photographer" href="https://leophotographer.com" />
    <div class="wrap">
      <span class="eyebrow light hero-in">Check Xpress Entertainment Availability</span>
      <h1 class="h-xl hero-in" style="margin:14px 0 18px;">So, you want to know if we're free on your date? 😏</h1>
      <p class="lead hero-in">Want to know if Xpress Entertainment is available? Unfortunately unlike other singles we arent on Tinder. However, you can slide in our DMs or fill out the form on this page to have a team member reach out and see if we are available on your date.</p>
    </div>
  </header>

  <section class="pad bg-ink">
    <div class="wrap">
      <div class="contact-grid">
        <div class="reveal">
          <span class="eyebrow">Check Availability ⬇️</span>
          <h2 class="h-lg" style="margin:14px 0 24px;">Tell us about your day.</h2>

          <div class="stepper" id="lead-stepper" aria-hidden="true">
            <span class="step-dot active"><b>1</b><span class="lbl">Your info</span></span>
            <span class="step-dot"><b>2</b><span class="lbl">Event</span></span>
            <span class="step-dot"><b>3</b><span class="lbl">Venue &amp; notes</span></span>
          </div>

          <form id="lead-form" novalidate>
            <!-- honeypot: hidden from humans -->
            <div aria-hidden="true" style="position:absolute; left:-9999px; height:0; overflow:hidden;">
              <label>Company<input type="text" id="company" name="company" tabindex="-1" autocomplete="off" /></label>
            </div>

            <!-- STEP 1 — Client info -->
            <div class="form-step" data-step="1">
              <div class="field-row">
                <div class="field"><label for="firstName">First Name *</label><input type="text" id="firstName" name="firstName" maxlength="100" autocomplete="given-name" required /></div>
                <div class="field"><label for="lastName">Last Name *</label><input type="text" id="lastName" name="lastName" maxlength="100" autocomplete="family-name" required /></div>
              </div>
              <div class="field-row">
                <div class="field"><label for="phone">Phone *</label><input type="tel" id="phone" name="phone" placeholder="(954) 000-0000" autocomplete="tel" required /></div>
                <div class="field"><label for="email">Email *</label><input type="email" id="email" name="email" placeholder="you@email.com" autocomplete="email" required /></div>
              </div>
              <div class="field">
                <label>Preferred language for communication *</label>
                <div class="radio-group">
                  <label class="radio"><input type="radio" name="commLanguage" value="English" required /> <span>English</span></label>
                  <label class="radio"><input type="radio" name="commLanguage" value="Spanish" /> <span>Español</span></label>
                </div>
              </div>
              <div class="field">
                <label>Preferred method of communication *</label>
                <div class="radio-group">
                  <label class="radio"><input type="radio" name="preferredMethod" value="SMS" required /> <span>Text me 📱</span></label>
                  <label class="radio"><input type="radio" name="preferredMethod" value="Email" /> <span>Email me ✉️</span></label>
                </div>
              </div>

              <label class="consent">
                <input type="checkbox" id="smsConsent" name="smsConsent" />
                <span>{CONSENT_TEXT}</span>
              </label>
              <p class="consent-hint">Optional, unless you'd like us to text you. Prefer email? Just choose "Email me" above.</p>
              <p class="consent-legal">By submitting this form you agree to our <a href="/privacy-policy">Privacy Policy</a> and <a href="/terms-of-service">Terms of Service</a>. Message frequency varies and message &amp; data rates may apply. Reply STOP to opt out or HELP for help.</p>
            </div>

            <!-- STEP 2 — Event info -->
            <div class="form-step" data-step="2" hidden>
              <div class="field"><label for="eventType">What type of event are you planning? *</label>
                <select id="eventType" name="eventType" required>
                  <option value="" selected disabled>Select one</option>
                  <option value="Wedding">Wedding</option>
                  <option value="Corporate Event">Corporate Event</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div class="field" id="grp-other" hidden>
                <label for="eventTypeOther">What type of event? (pick one) *</label>
                <select id="eventTypeOther" name="eventTypeOther" disabled>
                  <option value="" selected disabled>Select one</option>
                  {eventTypeOther.map((o) => <option value={o}>{o}</option>)}
                </select>
              </div>

              <div class="field"><label for="eventDate">Date of event *</label><input type="date" id="eventDate" name="eventDate" required /></div>

              <div class="field-row">
                <div class="field"><label for="guests">Estimated # of guests *</label><input type="number" min="1" max="5000" inputmode="numeric" id="guests" name="guests" required /><small class="hint">No final headcount needed — just a ballpark.</small></div>
                <div class="field"><label for="startTime">Estimated start time *</label><input type="text" id="startTime" name="startTime" placeholder="e.g. 6:00 PM" required /></div>
              </div>
              <div class="field"><label for="endTime">Estimated end time *</label><input type="text" id="endTime" name="endTime" placeholder="e.g. 11:00 PM" required /></div>

              <!-- shows when "Wedding" -->
              <div class="field" id="grp-relation" hidden>
                <label>Your relation to the wedding *</label>
                <div class="radio-group">
                  {relations.map((r) => (
                    <label class="radio"><input type="radio" name="relation" value={r} disabled /> <span>{r}</span></label>
                  ))}
                </div>
              </div>

              <!-- shows once a relation is chosen -->
              <div id="grp-partners" hidden>
                <div class="field-row">
                  <div class="field"><label for="partner1First">Partner 1 — First name *</label><input type="text" id="partner1First" name="partner1First" disabled /></div>
                  <div class="field"><label for="partner1Last">Partner 1 — Last name *</label><input type="text" id="partner1Last" name="partner1Last" disabled /></div>
                </div>
                <div class="field-row">
                  <div class="field"><label for="partner2First">Partner 2 — First name *</label><input type="text" id="partner2First" name="partner2First" disabled /></div>
                  <div class="field"><label for="partner2Last">Partner 2 — Last name *</label><input type="text" id="partner2Last" name="partner2Last" disabled /></div>
                </div>
              </div>
            </div>

            <!-- STEP 3 — Venue & notes -->
            <div class="form-step" data-step="3" hidden>
              <div class="field-row">
                <div class="field"><label for="venueName">Name of venue *</label><input type="text" id="venueName" name="venueName" maxlength="200" required /></div>
                <div class="field"><label for="venueCity">City of venue *</label><input type="text" id="venueCity" name="venueCity" maxlength="120" required /></div>
              </div>
              <div class="field"><label for="notes">Anything else you'd like us to know?</label><textarea id="notes" name="notes" maxlength="2000" rows="4" placeholder="Vibe, must-play songs, special moments..."></textarea></div>

              {TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="dark" style="margin:6px 0 18px;"></div>}
            </div>

            <p id="form-error" class="form-error" hidden></p>
            <div class="form-nav">
              <button type="button" class="btn ghost" data-nav="back" hidden><span>← Back</span></button>
              <button type="submit" class="btn" data-nav="next"><span class="btn-label">Next</span> <span class="arrow">↗</span></button>
            </div>
            <p style="color:var(--muted); font-size:0.8rem; margin-top:14px;">A team member will reach out to confirm availability for your date.</p>
          </form>

          <div id="form-success" class="lead-success" hidden tabindex="-1">
            <div class="success-head">
              <div class="success-icon" aria-hidden="true">🎉</div>
              <h3 class="h-lg">Inquiry received!</h3>
              <p class="lead">Thanks! Your event details are saved with the Xpress Entertainment team.</p>
            </div>
            <ul class="lead-status">
              <li class="is-done"><b>✓ Inquiry received</b><span>We have your contact and event details.</span></li>
              <li class="is-next"><b>Choose a consultation time</b><span>Pick a time below for a 20-minute video consultation on Google Meet. When your booking goes through, the calendar shows its own confirmation.</span></li>
              <li class="is-info"><b>Your date isn't reserved yet</b><span>An inquiry or a consultation doesn't hold your date. We'll confirm availability and next steps with you.</span></li>
            </ul>
            <p class="booking-tip">After you pick a time, your name, email and phone from this inquiry are filled in for you. Check them (you can edit them) before you confirm.</p>
            <div id="booking-embed" class="booking-embed"></div>
            <p id="booking-slow" class="form-error" hidden>The calendar is taking a while to load. <a href="/consult" target="_blank" rel="noopener">Open the booking page instead</a>, or call/text us at 954-833-1196.</p>
            <p class="booking-fallback">Calendar not loading? <a href="/consult" target="_blank" rel="noopener">Open the booking page</a> or call/text 954-833-1196.</p>
          </div>
        </div>

        <div class="reveal d1">
          <span class="eyebrow">Or reach us now</span>
          <h2 class="h-lg" style="margin:14px 0 30px;">Direct line.</h2>
          <a class="info-card" href="tel:9548331196" style="display:block;"><div class="k">Call or Text</div><div class="v">954 · 833 · 1196</div></a>
          <a class="info-card" href="mailto:events@xpressdjs.com" style="display:block;"><div class="k">Email</div><div class="v">events@xpressdjs.com</div></a>
          <div class="info-card"><div class="k">Service Area</div><div class="v" style="font-size:1.25rem;">Miami · Fort Lauderdale · Palm Beach · The Keys</div></div>
          <blockquote style="font-family:var(--serif); font-size:1.4rem; color:var(--lavender); border-left:3px solid var(--red); padding-left:20px; margin-top:24px; line-height:1.4;">“Oh, I wanna dance with somebody, I wanna feel the heat with somebody, Yeah! I wanna dance with somebody — with somebody who loves me.”</blockquote>
        </div>
      </div>
    </div>
  </section>

  <section class="cta pad">
    <div class="wrap">
      <span class="eyebrow light reveal">The Ultimate Wedding Experience</span>
      <h2 class="display reveal d1">See you on<br>the dance floor.</h2>
    </div>
  </section>

  {TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script is:inline define:vars={{ leadCfg }}>window.__leadCfg = leadCfg;</script>
  <script is:inline src="/js/lead-form.js"></script>
</Base>
