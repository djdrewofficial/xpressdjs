---
import Base from '../layouts/Base.astro';
---
<Base title="Book Your Creative Planning Meeting | Xpress Entertainment" description="Meet with Drew Segura to start planning the entertainment for your South Florida wedding. Pick a time for your Creative Planning Meeting below.">

  <section class="pad bg-ink" style="padding-top:130px;">
    <div class="wrap">
      <div class="sec-head reveal" style="max-width:760px;">
        <span class="eyebrow">Creative Planning Meeting</span>
        <h1 class="h-xl">Let's plan your wedding entertainment.</h1>
        <p class="lead">This is where the magic starts. Book your Creative Planning Meeting with Drew Segura to map out the entertainment for your big day — your vibe, your must-plays, your show-stopping moments. Pick a time that works for you below.</p>
      </div>
      <div class="booking-embed reveal">
        <iframe src="https://api.leadconnectorhq.com/widget/booking/GocqVkurMGSf07xLUzsJ" style="width:100%; border:none; overflow:hidden; min-height:780px;" scrolling="no" id="GocqVkurMGSf07xLUzsJ_1779743441139"></iframe>
      </div>
    </div>
  </section>

  <script is:inline src="https://link.msgsndr.com/js/form_embed.js" type="text/javascript"></script>
</Base>

<style>
  .booking-embed { margin-top: 30px; border-radius: var(--radius); overflow: hidden; background: #fff; box-shadow: 0 30px 80px rgba(0,0,0,0.35); }
  .booking-embed iframe { display: block; width: 100%; border: 0; }
</style>
