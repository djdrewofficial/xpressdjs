---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import VideoLightbox from '../../components/VideoLightbox.astro';
import SocialFollow from '../../components/SocialFollow.astro';
import { localize } from '../../i18n/ui';
const L = (p) => localize(p, 'es');

const socials = [
  { platform: 'instagram',  url: 'https://instagram.com/djdrewofficial',   handle: '@djdrewofficial' },
  { platform: 'mixcloud',   url: 'https://mixcloud.com/djdrewofficial',    handle: 'djdrewofficial' },
  { platform: 'soundcloud', url: 'https://soundcloud.com/djdrewofficial',  handle: 'djdrewofficial' },
  { platform: 'youtube',    url: 'https://youtube.com/@djdrewofficial',    handle: '@djdrewofficial' },
  { platform: 'tiktok',     url: 'https://tiktok.com/@djdrewofficiall',    handle: '@djdrewofficiall' },
];
const reels = [
  { url: 'https://www.instagram.com/reel/DUw7-a3jepU/', cover: '/images/social/drew-reel-1.jpg', handle: '@djdrewofficial' },
  { url: 'https://www.instagram.com/reel/DT8j0FBERzN/', cover: '/images/social/drew-reel-2.jpg', handle: '@djdrewofficial' },
];

const why = [
  ['🎤 MC carismático y motivador del público', 'Drew aporta la energía, lee al público y hace que cada anuncio se sienta personal—manteniendo a tus invitados involucrados desde el “sí, acepto” hasta el último baile.'],
  ['🎧 Mezcla de formato abierto para bodas diversas', 'Mezcla con maestría Reggaeton, Merengue, Freestyle, clásicos de los 2000, Pop, EDM y más—a la medida de públicos multiculturales y familias bilingües.'],
  ['🌟 Especialista en DJ de bodas', 'Aunque ha encendido discotecas y otros eventos, las bodas son su verdadera pasión. Drew creó Xpress Entertainment justamente para enfocarse en experiencias de boda épicas.'],
  ['🎶 Banda sonora impecable de principio a fin', 'Sin silencios incómodos, sin momentos perdidos—solo transiciones suaves y buena energía sin parar.'],
];
---
<Base title="DJ Drew Segura | DJ de bodas bilingüe en el sur de Florida — Xpress Entertainment" description="DJ Drew Segura — fundador de Xpress Entertainment. Más de 8 años, más de 100 bodas al año, bilingüe (inglés y español), formato abierto. Reggaeton, música latina, Top 40 y más.">

  <Hero
    eyebrow="DJ de bodas y eventos del sur de Florida"
    titleHtml={`DJ Drew<br>Segura`}
    sub="Desde bodas íntimas frente al mar hasta vida nocturna llena de energía en Fort Lauderdale, DJ Drew Segura aporta más de 8 años de experiencia, una formación bilingüe (inglés y español) y habilidades inigualables de mezcla en formato abierto. La confianza de más de 100 parejas al año."
    image="/images/heroes/dj-drew-hero.jpg"
    alt="DJ Drew Segura — MC y DJ de bodas"
    ctaText="Consulta Disponibilidad"
    ctaHref={L('/check-availability')}
    creditName="The Schau Photography"
    creditHref="https://theschau.com/"
  />

  <section class="pad bg-ink">
    <div class="wrap">
      <div class="split">
        <div class="media reveal" style="background:var(--ink-2);"><img src="/images/djs/drew-segura-headshot.png" alt="DJ Drew Segura — DJ de bodas del sur de Florida" style="aspect-ratio:1; object-fit:cover; width:100%; height:100%;" /></div>
        <div class="reveal d1">
          <span class="eyebrow">🌎 DJ de bodas y eventos bilingüe con base en el sur de Florida</span>
          <h2 class="h-lg" style="margin:14px 0 18px;">Más de 100 bodas cada año</h2>
          <p class="lead">Con más de una década de experiencia y más de 100 bodas al año, DJ Drew Segura es uno de los DJs bilingües más solicitados del sur de Florida. Desde lugares frente al agua en West Palm Beach hasta elegantes salones de hotel en Miami, es reconocido por crear pistas de baile inolvidables y llenas de energía que conquistan a cada generación y cultura.</p>
          <p class="lead" style="margin-top:14px;">Criado en un hogar domínico-americano y fluido tanto en inglés como en español, Drew es un experto en mezclar éxitos latinos con Top 40, Hip-Hop, EDM y clásicos de bodas. Ya sea que estés planeando una boda relajada en la playa o un evento de etiqueta de lujo, Drew sabe cómo leer el ambiente y crear una vibra de la que tus invitados hablarán por años.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="pad bg-deep">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow light">Por qué las parejas y los organizadores de eventos reservan a DJ Drew Segura</span><h2 class="h-xl">Toda la noche, resuelta.</h2></div>
      <div class="values" style="grid-template-columns:repeat(2,1fr);">
        {why.map(([t, d], i) => (
          <div class={`value reveal ${i % 2 ? 'd1' : ''}`} style="border-color:rgba(255,255,255,0.14); color:#fff;"><h3>{t}</h3><p style="color:#d9d0ec;">{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="pad bg-deep">
    <div class="wrap" style="max-width:1040px;">
      <div class="sec-head center reveal"><span class="eyebrow light">▶ Mira bodas reales</span><h2 class="h-xl">Ve a Drew en vivo.</h2></div>
      <div class="video-grid">
        <VideoLightbox compact id="IfiDx2t5OZI" label="DJ Drew Segura — boda en vivo en Vista Lago Ballroom" />
        <VideoLightbox compact class="d1" id="8jkro4IHl2g" label="DJ Drew Segura — destacado de boda en vivo" />
        <VideoLightbox compact class="d1" id="10994qjwqx8" label="DJ Drew Segura — destacado de boda en vivo" />
        <VideoLightbox compact id="vub-gogjGhQ" label="DJ Drew Segura — destacado de boda en vivo" />
      </div>
      <blockquote class="reveal d1" style="font-family:var(--serif); font-size:clamp(1.4rem,3vw,2.2rem); color:var(--lavender); text-align:center; max-width:880px; margin:40px auto 0; line-height:1.4;">Un mundo de música, una pista de baile inolvidable — Reggaeton, Hip-Hop de los 2000, Salsa, EDM y éxitos pop para cantar a coro, todo a la medida de tu público.</blockquote>
    </div>
  </section>

  <section class="pad bg-ink">
    <div class="wrap" style="max-width:880px;">
      <div class="sec-head reveal" style="max-width:none;"><span class="eyebrow">Más allá de la cabina</span><h2 class="h-lg">Un DJ de bodas con corazón y experiencia</h2></div>
      <p class="lead reveal d1">Fuera del escenario, DJ Drew Segura es mucho más que un profesional de la música — es un narrador, anfitrión y creador de ambientes. Con raíces dominicanas y una profunda pasión por las bodas, Drew ha construido una carrera dedicada a llevar alegría, energía y personalización a las parejas de todo el sur de Florida y más allá.</p>
      <ul class="reveal d2" style="margin:22px 0 0 20px; color:#d9d0ec; line-height:2;"><li>🎶 Un profundo entendimiento del flujo de la boda — desde la ceremonia hasta el gran final</li><li>🌴 El sabor musical del sur de Florida con encanto bilingüe</li><li>✨ Una presencia tranquila, divertida y profesional que da seguridad a las parejas</li><li>❤️ Una pasión por crear una banda sonora que refleje tu cultura, tu historia de amor y tu estilo</li></ul>
      <p class="lead reveal d2" style="margin-top:18px; color:#fff;">Con DJ Drew detrás de la cabina, no solo contratas a alguien para poner música — reservas a un aliado que de verdad se preocupa por hacer tu boda inolvidable.</p>
    </div>
  </section>

  <SocialFollow name="DJ Drew" links={socials} reels={reels} />

  <CTA eyebrow="Reserva a DJ Drew Segura" titleHtml={`Hazla<br>inolvidable.`} />
</Base>
