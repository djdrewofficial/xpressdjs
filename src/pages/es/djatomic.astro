---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import VideoLightbox from '../../components/VideoLightbox.astro';
import SocialFollow from '../../components/SocialFollow.astro';
import { localize } from '../../i18n/ui';
const L = (p) => localize(p, 'es');

const socials = [
  { platform: 'instagram', url: 'https://instagram.com/djatomicentertainment', handle: '@djatomicentertainment' },
];

const why = [
  ['🎤 MC carismático y motivador del público', 'Aporta la energía y mantiene a tus invitados involucrados desde el primer anuncio hasta la última canción.'],
  ['🎚️ Mezcla de formato abierto entre culturas', 'Combina sin esfuerzo géneros como Reggaeton, Soca, Top 40, Hip-Hop, EDM y más—personalizado para tu público.'],
  ['🌍 Experiencia comprobada como DJ a nivel global', 'Desde Saint Lucia hasta el sur de Florida, ha encendido escenarios en todo el mundo y sabe cómo adaptar la música a cualquier audiencia.'],
  ['🔊 Música impecable desde el “sí, acepto” hasta el último baile', 'Sin silencios incómodos, sin momentos perdidos—solo transiciones suaves y buena energía sin parar.'],
];
---
<Base title="DJ Atomic | DJ internacional de bodas y eventos en el sur de Florida — Xpress Entertainment" description="DJ Atomic — DJ internacional de bodas y eventos con base en el sur de Florida. Más de 600 eventos, estilo multicultural, mezclas impecables y la capacidad de leer cualquier ambiente.">

  <Hero
    eyebrow="DJ de bodas y eventos del sur de Florida"
    titleHtml={`DJ <span class="serif-accent" style="font-style:italic">Atomic</span>`}
    sub="Desde cruceros de lujo hasta bodas inolvidables en el sur de Florida, DJ Atomic aporta experiencia global y vibras llenas de energía a cada celebración."
    image="/images/heroes/dj-atomic-hero.jpg"
    alt="DJ Atomic — DJ y MC de bodas en Miami y Fort Lauderdale"
    ctaText="Consulta Disponibilidad"
    ctaHref={L('/check-availability')}
    creditName="Leo Photographer"
    creditHref="https://leophotographer.com"
  />

  <section class="pad bg-ink">
    <div class="wrap">
      <div class="split rev">
        <div class="media reveal" style="background:var(--ink-2);"><img src="/images/djs/dj-atomic-headshot.jpg" alt="Foto de DJ Atomic — DJ y MC de bodas en Miami y Fort Lauderdale" style="aspect-ratio:1; object-fit:cover; width:100%; height:100%;" /></div>
        <div class="reveal d1">
          <span class="eyebrow">🌍 DJ internacional de bodas y eventos con base en el sur de Florida</span>
          <h2 class="h-lg" style="margin:14px 0 18px;">Más de 600 bodas inolvidables</h2>
          <p class="lead">Con un historial de más de 600 bodas y eventos, DJ Atomic aporta un nivel de experiencia de élite a cada celebración. Desde cruceros y resorts de lujo hasta vibrantes bodas en el sur de Florida y escenarios internacionales, no es solo un DJ—es un artista de clase mundial con corazón local.</p>
          <p class="lead" style="margin-top:14px;">Originario de Saint Lucia y ahora con base en el sur de Florida, DJ Atomic es reconocido por su estilo musical multicultural, sus mezclas impecables y su capacidad de leer cualquier ambiente. Ya sea una ceremonia frente al mar, una elegante recepción en un salón o una boda de destino, crea una banda sonora llena de energía que mantiene a tus invitados bailando toda la noche.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="pad bg-deep">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow light">🔥 Por qué las parejas y los organizadores de eventos reservan a DJ Atomic</span><h2 class="h-xl">Un artista de clase mundial.</h2></div>
      <div class="values" style="grid-template-columns:repeat(2,1fr);">
        {why.map(([t, d], i) => (
          <div class={`value reveal ${i % 2 ? 'd1' : ''}`} style="border-color:rgba(255,255,255,0.14); color:#fff;"><h3>{t}</h3><p style="color:#d9d0ec;">{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="pad bg-deep">
    <div class="wrap" style="max-width:1040px;">
      <div class="sec-head center reveal"><span class="eyebrow light">▶ Mira la Xperiencia</span><h2 class="h-xl">Ve a Atomic en vivo.</h2></div>
      <div class="video-grid">
        <VideoLightbox compact id="kH4JBmuWiHc" label="DJ Atomic — destacado de boda en vivo" />
        <VideoLightbox compact class="d1" id="VZIEL4B_y4c" label="DJ Atomic — destacado de boda en vivo" />
      </div>
      <blockquote class="reveal d1" style="font-family:var(--serif); font-size:clamp(1.4rem,3vw,2.2rem); color:var(--lavender); text-align:center; max-width:880px; margin:40px auto 0; line-height:1.4;">Un mundo de sonido, una pista de baile llena — Soca, Reggaeton, R&B y clásicos de los 70, creando la mezcla perfecta toda la noche.</blockquote>
    </div>
  </section>

  <section class="pad bg-ink">
    <div class="wrap" style="max-width:880px;">
      <div class="sec-head reveal" style="max-width:none;"><span class="eyebrow">Más allá de la cabina</span><h2 class="h-lg">Un DJ de bodas con alma global</h2></div>
      <p class="lead reveal d1">Fuera del escenario, DJ Atomic es mucho más que un profesional de la música—es un narrador y creador de ambientes. Con raíces en Saint Lucia y años de experiencia en bodas a través de resorts de lujo, lugares de destino y puntos clave del sur de Florida, Atomic aporta una perspectiva global al gran día de cada pareja.</p>
      <ul class="reveal d2" style="margin:22px 0 0 20px; color:#d9d0ec; line-height:2;"><li>🎶 Un profundo entendimiento de los momentos de la boda—desde la ceremonia hasta el último baile</li><li>🌎 Conocimiento musical global con un toque personal</li><li>✨ Una presencia tranquila y profesional que ayuda a las parejas a sentirse a gusto</li><li>🖤 Una pasión por crear bandas sonoras que reflejen tu historia de amor</li></ul>
      <p class="lead reveal d2" style="margin-top:18px; color:#fff;">Con Atomic detrás de la cabina, no solo reservas a un DJ—llevas corazón, energía y recuerdos inolvidables al día de tu boda.</p>
    </div>
  </section>

  <SocialFollow name="DJ Atomic" links={socials} />

  <CTA eyebrow="Reserva a DJ Atomic" titleHtml={`Una experiencia<br>inolvidable.`} />
</Base>
