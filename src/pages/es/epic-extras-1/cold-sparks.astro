---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/Hero.astro';
import CTA from '../../../components/CTA.astro';
import { localize } from '../../../i18n/ui';
const L = (p) => localize(p, 'es');

const why = [
  ['Visualmente Impresionante', 'Crea un deslumbrante efecto de chispas sin los riesgos asociados con los fuegos artificiales o la pirotecnia.'],
  ['Seguras para los Invitados', 'Las chispas son frías al tacto, reduciendo los riesgos de incendio y haciéndolas seguras para uso en interiores y exteriores.'],
  ['Alturas Personalizables', 'Controlaremos la altura de las chispas, que va de 3 a 10 pies, para combinar con el estilo y la atmósfera de tu boda.'],
  ['Perfectas para Momentos Clave', 'Ideales para tu primer baile, gran entrada, corte del pastel y salida.'],
];
---
<Base title="Máquinas de Chispas Frías para Bodas | Xpress Entertainment" description="Eleva tu boda con Máquinas de Chispas Frías: chispas no pirotécnicas, frías al tacto, que agregan drama y emoción, seguras para salones interiores o exteriores en el sur de Florida.">

  <Hero
    size="mid"
    eyebrow="Extras Épicos"
    titleHtml={`Chispas Frías para<br>Bodas<br>Inolvidables`}
    sub="Ya sea tu gran entrada, tu primer baile o tu despedida, las Máquinas de Chispas Frías crean un espectáculo impresionante de chispas que agrega drama y emoción a tu gran día."
    image="/images/cold-spark-machines.jpg"
    alt="Pareja bailando en las nubes mientras chispas frías caen detrás de ellos en su boda"
    ctaText="Consulta Disponibilidad"
    creditName="Amarena Productions"
    creditHref="https://amarenaproductions.com/"
  />

  <section class="pad bg-ink">
    <div class="wrap" style="max-width:880px;">
      <p class="lead reveal">Eleva tu boda con la magia de las Máquinas de Chispas Frías de Xpress Entertainment. Estas máquinas no pirotécnicas producen chispas frías al tacto, lo que las convierte en una opción segura e impresionante para salones de boda interiores o exteriores.</p>
      <p class="lead reveal d1" style="margin-top:14px;">A diferencia de los fuegos artificiales tradicionales, las chispas frías son seguras y libres de calor, humo y olores fuertes, lo que las hace ideales para bodas de cualquier tamaño.</p>
    </div>
  </section>

  <section class="pad bg-deep">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow light">¿Por qué elegir chispas frías?</span><h2 class="h-xl">El factor "wow", de forma segura.</h2></div>
      <div class="values" style="grid-template-columns:repeat(2,1fr);">
        {why.map(([t, d], i) => (
          <div class={`value reveal ${i % 2 ? 'd1' : ''}`} style="border-color:rgba(255,255,255,0.14); color:#fff;"><h3>{t}</h3><p style="color:#d9d0ec;">{d}</p></div>
        ))}
      </div>
      <p class="lead reveal" style="max-width:820px; margin:34px auto 0; text-align:center;">En Xpress Entertainment, combinamos las Máquinas de Chispas Frías con nuestros servicios profesionales de DJ e iluminación para asegurar que la sincronización y coordinación de los efectos de chispas combinen perfectamente con el ritmo de tu celebración. Nuestros técnicos capacitados operarán las máquinas, permitiéndote disfrutar tu día sin estrés.</p>
    </div>
  </section>

  <CTA eyebrow="Contáctanos para renta de chispas frías" titleHtml={`Ilumina<br>el salón.`} text="Cuéntanos tu fecha. Te mostraremos lo natural que puede sentirse una noche inolvidable." ctaText="Consulta Tu Fecha" ctaHref={L('/check-availability')} />
</Base>
