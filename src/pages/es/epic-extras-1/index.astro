---
import Base from '../../../layouts/Base.astro';
import Hero from '../../../components/Hero.astro';
import CTA from '../../../components/CTA.astro';
import Ph from '../../../components/Ph.astro';
import Credit from '../../../components/Credit.astro';
import { localize } from '../../../i18n/ui';
const L = (p) => localize(p, 'es');

const extras = [
  { t: '☁️ Bailando en las Nubes', s: 'Siéntete como en un sueño.', d: 'Esta niebla a ras del suelo crea un piso parecido a una nube durante tu primer baile o tu momento especial: ideal para un ambiente romántico y fotos impresionantes.', use: '💭 Mejor uso: Primer baile, canciones lentas, ambiente de boda de ensueño', href: L('/epic-extras-1/dancing-on-the-clouds'), img: '/images/dancing-on-the-clouds.jpg', alt: 'Pareja compartiendo su primer baile sobre las nubes en su boda en Miami', credit: 'Sid Rashlich', creditHref: 'https://photovsl.com/' },
  { t: '✨ Máquinas de Chispas Frías', s: 'Las chispas vuelan, de forma segura.', d: 'Estas máquinas de chispas frías crean un efecto dramático y seguro para interiores, sin fuego ni humo. Úsalas en tu primer baile, tu entrada o un gran momento de la fiesta.', use: '✨ Perfecto para: Salones interiores, fiestas al aire libre y esos momentos dramáticos e inolvidables', href: L('/epic-extras-1/cold-sparks'), img: '/images/cold-spark-machines.jpg', alt: 'Pareja bailando en las nubes mientras chispas frías caen detrás de ellos en su boda', credit: 'Amarena Productions', creditHref: 'https://amarenaproductions.com/' },
  { t: '🎨 Diseño y Proyección de Monograma Personalizado', s: 'Pon tu amor en luces.', d: 'Muestra tus iniciales, el logo de tu boda o un diseño totalmente personalizado en la pista de baile, el fondo o la pared del salón. Un detalle elegante y estiloso que hace que tu celebración se sienta realmente personal.', use: '📸 Popular para: Entradas elegantes, sesiones de fotos y darle identidad a tu gran día', href: L('/epic-extras-1/lighting'), img: '/images/monogram-projection.jpg', alt: 'Monograma de boda personalizado proyectado en la pared de un salón de Miami' },
  { t: '🧊 Pistolas y Cañones de CO2', s: 'Es hora de subir la energía de la fiesta.', d: 'Nuestros efectos de CO2 lanzan ráfagas rápidas de niebla, agregando emoción y movimiento a la pista de baile. Totalmente seguros y totalmente inolvidables.', use: '🎉 Perfecto para: Grandes entradas, sets de baile de medianoche y momentos sorpresa del DJ', href: L('/check-availability'), img: '/images/co2-cannons.jpg', alt: 'Novios disparando cañones de CO2 frente a la cabina del DJ', credit: 'Simply Captivating', creditHref: 'https://simplycaptivating.com' },
  { t: '🕴🏽 Show de Luces Estilo Club', s: 'Lleva esa energía de la vida nocturna a tu boda.', d: 'Nuestro show de luces inteligentes crea una experiencia visual dinámica y sincronizada con la música que mantiene viva la pista de baile y a tus invitados completamente inmersos.', use: '🔥 Ideal para: La hora de la fiesta en la recepción, playlists con energía e invitados que aman bailar', href: L('/epic-extras-1/lighting'), img: '/images/club-style-light-show.jpg', alt: 'Pista de baile llena de energía bajo un show de luces estilo club en una boda', credit: 'Amarena Productions', creditHref: 'https://amarenaproductions.com/' },
  { t: '🌈 Iluminación Ambiental', s: 'Pon tu amor en luces.', d: 'Luces ambientales colocadas estratégicamente proyectan un hermoso resplandor sobre paredes, columnas y decoración, personalizables para combinar con los colores de tu boda.', use: '📍 Excelente para: Recepciones, fondos de ceremonia y momentos fotográficos inolvidables', href: L('/epic-extras-1/lighting'), img: '/images/uplighting.jpg', alt: 'Iluminación ambiental ámbar en las paredes del salón mientras el padrino da su discurso' },
];
---
<Base title="Extras Épicos para Tu Boda | Xpress Entertainment" description="Agrega ese toque extra: bailando en las nubes, chispas frías, monogramas personalizados, CO2, iluminación estilo club e iluminación ambiental para bodas en el sur de Florida. Los momentos wow que tus invitados grabarán.">

  <Hero
    eyebrow="Extras Épicos"
    titleHtml={`Agrega Ese <span class="serif-accent" style="font-style:italic">✨ Toque Extra ✨</span><br>a Tu Día de Boda`}
    sub="En Xpress Entertainment, nos encantan esos momentos wow que hacen que tu boda se sienta completamente tuya. Desde la iluminación hasta los visuales personalizados, estos complementos para bodas están diseñados para realzar tu experiencia, impresionar a tus invitados y mantener la energía toda la noche."
    image="/images/heroes/epic-extras-hero.jpg"
    alt="Pareja bailando mientras chispas frías vuelan detrás de ellos en una boda en el sur de Florida"
    ctaText="Consulta Disponibilidad"
    creditName="The Schau Photography"
    creditHref="https://theschau.com/"
  />

  <section class="pad bg-ink">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow">Explora nuestros extras más queridos</span><h2 class="h-xl">Crea un momento.</h2></div>
      <div class="cards">
        {extras.map((e, i) => {
          const cls = `card card-extra reveal ${i % 3 === 1 ? 'd1' : i % 3 === 2 ? 'd2' : ''}`;
          const card = (
            <a class={cls} href={e.href} style="aspect-ratio:auto; min-height:340px;">
              {e.img ? <img src={e.img} alt={e.alt} /> : <Ph w={1200} h={900} label={e.t} note="Foto destacada para este extra" />}
              <div class="card-body">
                <h3 style="font-size:1.4rem;">{e.t}</h3>
                <p style="max-height:none; opacity:1; margin:8px 0;"><strong style="color:#fff;">{e.s}</strong> {e.d}</p>
                <p style="max-height:none; opacity:1; color:var(--lavender); font-size:0.85rem;">{e.use}</p>
              </div>
            </a>
          );
          return e.credit
            ? <div class="card-cell">{card}<Credit variant="overlay" pos="top" name={e.credit} href={e.creditHref} /></div>
            : card;
        })}
      </div>
    </div>
  </section>

  <CTA eyebrow="Hazlo a lo grande" titleHtml={`Hazlo<br>cinematográfico.`} text="Cuéntanos tu fecha. Te mostraremos lo natural que puede sentirse una noche inolvidable." ctaText="Consulta Tu Fecha" ctaHref={L('/check-availability')} />
</Base>
