---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
---
<Base title="Elige Tu Plantilla de Cabina de Fotos | Xpress Entertainment" description="Explora y selecciona tu plantilla de impresión personalizada para la cabina de fotos de tu boda o evento en el sur de Florida — elige el diseño perfecto para tu celebración.">

  <section class="pad bg-ink" style="padding-top:130px;">
    <div class="wrap">
      <div class="sec-head reveal" style="max-width:760px;">
        <span class="eyebrow">Cabinas de Fotos</span>
        <h1 class="h-xl">Elige Tu Plantilla de Cabina de Fotos</h1>
        <p class="lead">Explora nuestros diseños de impresión para cabina de fotos y selecciona la plantilla que más te guste para tu evento. ¿Encontraste tu favorita? Avísale a tu DJ y la dejamos lista.</p>
      </div>
      <div class="tb-embed reveal">
        <iframe srcdoc="Cargando..." onload="this.removeAttribute('srcdoc')" src="https://templatesbooth.com/widget-embed/?key=MjY2Mw%3D%3D" scrolling="yes" width="100%" height="2200px" frameborder="0" id="tb-widget-embed-98faddd055"></iframe>
      </div>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .tb-embed { margin-top: 30px; border-radius: var(--radius); overflow: hidden; background: #fff; box-shadow: 0 30px 80px rgba(0,0,0,0.35); }
  .tb-embed iframe { display: block; width: 100%; border: 0; }
</style>
