---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import Credit from '../../components/Credit.astro';
import { localize } from '../../i18n/ui';
const L = (p) => localize(p, 'es');

const why = [
  ['🎤 MC carismático y motivador del público', 'Aporta la energía y mantiene a tus invitados involucrados desde el primer anuncio hasta la última canción.'],
  ['🎚️ Mezcla de formato abierto entre culturas', 'Combina sin esfuerzo géneros como Reggaeton, Top 40, Hip-Hop, EDM y más—personalizado para tu público.'],
  ['🌍 Trilingüe entre culturas', 'Desde Miami hasta el sur de Florida, ha encendido escenarios en todo el mundo y sabe cómo adaptar la música a cualquier audiencia.'],
  ['🔊 Música impecable desde el “sí, acepto” hasta el último baile', 'Sin silencios incómodos, sin momentos perdidos—solo transiciones suaves y buena energía sin parar.'],
];
---
<Base title="DJ Phil | DJ multicultural de bodas en Miami — Xpress Entertainment" description="DJ Phil — DJ multicultural de bodas con base en Miami, con más de 12 años de experiencia, más de 250 eventos y más de 35,000 invitados felices. Trilingüe, formato abierto, mucha energía.">

  <Hero
    eyebrow="DJ de bodas y eventos del sur de Florida"
    titleHtml={`DJ Phil`}
    sub="A lo largo de bodas, eventos corporativos y celebraciones privadas en el sur de Florida, DJ Phil aporta más de 12 años de experiencia multicultural y vibras llenas de energía a cada evento."
    image="/images/heroes/dj-phil-hero.jpg"
    alt="DJ Phil actuando en una recepción de boda en el sur de Florida"
    ctaText="Consulta Disponibilidad"
    ctaHref={L('/check-availability')}
  />

  <section class="pad bg-ink">
    <div class="wrap">
      <div class="split">
        <div class="media reveal" style="background:var(--ink-2);"><img src="/images/djs/dj-phil-headshot.jpg" alt="DJ Phil — foto de DJ multicultural de bodas en Miami" style="aspect-ratio:1; object-fit:cover; width:100%; height:100%;" /></div>
        <div class="reveal d1">
          <span class="eyebrow">🌍 DJ multicultural de bodas y eventos con base en Miami</span>
          <h2 class="h-lg" style="margin:14px 0 18px;">Más de 250 eventos y más de 35,000 invitados felices</h2>
          <p class="lead">Con un historial de más de 250 eventos, DJ Phil aporta un nivel de experiencia de élite a cada celebración. Desde lugares del sur de Florida y resorts de lujo hasta vibrantes bodas en el sur de Florida y escenarios internacionales, no es solo un DJ—es un artista de clase mundial con corazón local.</p>
          <p class="lead" style="margin-top:14px;">Con base en Miami y profundas raíces en el sur de Florida, DJ Phil es reconocido por su estilo musical multicultural, sus mezclas impecables y su capacidad de leer cualquier ambiente. Ya sea una ceremonia frente al mar, una elegante recepción en un salón o una boda de destino, crea una banda sonora llena de energía que mantiene a tus invitados bailando toda la noche.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="pad bg-deep">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow light">🔥 Por qué las parejas y los organizadores de eventos reservan a DJ Phil</span><h2 class="h-xl">Un sonido para cada invitado.</h2></div>
      <div class="values" style="grid-template-columns:repeat(2,1fr);">
        {why.map(([t, d], i) => (
          <div class={`value reveal ${i % 2 ? 'd1' : ''}`} style="border-color:rgba(255,255,255,0.14); color:#fff;"><h3>{t}</h3><p style="color:#d9d0ec;">{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="showcase">
    <img src="/images/dj-phil-packed-dance-floor.jpg" alt="DJ Phil encendiendo una pista de baile llena en una boda del sur de Florida" />
    <Credit variant="overlay" name="Jupiter Wedding Photo" href="https://www.jupiterweddingphoto.com/" />
    <div class="wrap" style="max-width:900px;"><blockquote class="reveal" style="max-width:none; font-size:clamp(1.4rem,3vw,2.4rem);">Un mundo de sonido, una pista de baile llena — Reggaeton, éxitos de Top 40, hip-hop y clásicos de los 80, 90 y 2000.</blockquote></div>
  </section>

  <section class="pad bg-ink">
    <div class="wrap" style="max-width:880px;">
      <div class="sec-head reveal" style="max-width:none;"><span class="eyebrow">Más allá de la cabina</span><h2 class="h-lg">Un DJ de bodas con alma global</h2></div>
      <p class="lead reveal d1">Fuera del escenario, DJ Phil es mucho más que un profesional de la música—es un narrador y creador de ambientes. Con raíces en Miami y años de experiencia en bodas a través de resorts de lujo, lugares de destino y puntos clave del sur de Florida, Phil aporta una perspectiva global al gran día de cada pareja.</p>
      <ul class="reveal d2" style="margin:22px 0 0 20px; color:#d9d0ec; line-height:2;"><li>🎶 Un profundo entendimiento de los momentos de la boda—desde la ceremonia hasta el último baile</li><li>🌎 Conocimiento musical global con un toque personal</li><li>✨ Una presencia tranquila y profesional que ayuda a las parejas a sentirse a gusto</li><li>🖤 Una pasión por crear bandas sonoras que reflejen tu historia de amor</li></ul>
      <p class="lead reveal d2" style="margin-top:18px; color:#fff;">Con Phil detrás de la cabina, no solo reservas a un DJ—llevas corazón, energía y recuerdos inolvidables al día de tu boda.</p>
    </div>
  </section>

  <CTA eyebrow="Reserva a DJ Phil" titleHtml={`Que empiece<br>la fiesta.`} />
</Base>
