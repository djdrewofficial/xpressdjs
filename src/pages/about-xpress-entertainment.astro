---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { phUri } from '../lib/ph';

const team = [
  { name: 'Drew Segura', role: 'Founder & Lead DJ', img: '/images/djs/drew-segura-headshot.png' },
  { name: 'Laura Del Gordo', role: 'Office Manager', img: '/images/djs/laura-del-gordo-headshot.jpg' },
  { name: 'Isabella Hernandez', role: 'Social Media & Marketing', img: '/images/djs/isabella-hernandez-headshot.jpg' },
  { name: 'Stephanie Estrada', role: 'Social Media & Content', img: '/images/djs/stephanie-estrada-headshot.jpg' },
  { name: 'Naqeeb Mohamed', role: 'Logistics & Lighting', img: '/images/djs/naqeeb-mohamed-headshot.jpg' },
  { name: 'Ruben Catero', role: 'Logistics & Photobooth', img: '/images/djs/ruben-catero-headshot.jpg' },
  { name: 'Dimitri (DJ Atomic)', role: 'DJ & MC', img: '/images/djs/dj-atomic-headshot.jpg' },
  { name: 'DJ ReRe', role: 'DJ & MC', img: '/images/djs/dj-rere-headshot.jpg' },
];

const reasons = [
  { t: '🎧 Custom Music Vibes', d: 'No generic playlists — we tailor every moment to your taste and your guests’ energy.' },
  { t: '🕺 Packed Dance Floors, Always', d: 'We read the crowd and keep the party going — from your tío to your college crew.' },
  { t: '🌎 Multicultural & Bilingual DJs', d: 'We specialize in multicultural weddings and speak both English & Spanish fluently.' },
  { t: '🎤 Professional Hosts, Not Just DJs', d: 'We guide your timeline smoothly — entrances, toasts, dances and all the moments in between.' },
  { t: '✨ Our Magical Epic Extras', d: 'From photo booths to cold sparks and uplighting — we bring all the fun.' },
  { t: '📍 South Florida Wedding Pros', d: 'We know the venues, the vendors, and how to make your Miami-area celebration flawless.' },
];
---
<Base title="About Xpress Entertainment | South Florida Wedding DJs" description="From a dream to 100+ weddings a year. Meet the bilingual, multicultural team behind Xpress Entertainment — your go-to wedding DJ team in South Florida.">

  <Hero
    size="mid"
    eyebrow="About us"
    titleHtml={`Your Wedding's Secret Weapon<br><span class="serif-accent" style="font-style:italic">(Besides Love, of course)</span>`}
    image={phUri(2560, 1440, 'About — hero', 'Team photo or wide celebration shot')}
    alt="Xpress Entertainment wedding"
    ctaText="Check Availability"
  />

  <section class="pad bg-ink">
    <div class="wrap" style="max-width:880px;">
      <p class="lead reveal">Hey there! We’re Xpress Entertainment, your go-to wedding DJ team in South Florida. We’re not just here to play music — we’re here to bring the vibe, guide the flow, and keep your party lit from the “I do” to the last dance. From romantic backyard weddings to luxury venues in Miami and Fort Lauderdale, we specialize in creating unforgettable moments through music, lighting, and crowd connection.</p>
    </div>
  </section>

  <!-- STORY -->
  <section class="pad bg-deep">
    <div class="wrap">
      <div class="split">
        <div class="media reveal"><img src="/images/xpress-team-photo.jpg" alt="The Xpress Entertainment crew at Top Golf for their Christmas party" style="aspect-ratio:4/3;" /></div>
        <div class="reveal d1">
          <span class="eyebrow light">From a dream…</span>
          <h2 class="h-lg" style="margin:14px 0 18px;">…to 100+ weddings a year.</h2>
          <p class="lead">Xpress Entertainment began in 2016 when Drew Segura, a passionate bilingual DJ, took his love for music and turned it into a one-man show at a Pompano Beach wedding venue.</p>
          <p class="lead" style="margin-top:14px;">What started small quickly evolved into one of the most loved wedding entertainment companies in South Florida — known for our personalized approach, multicultural flair, and unmatched crowd-reading skills.</p>
          <p class="lead" style="margin-top:14px;">Now we’re a full team, rocking over 100 weddings a year, plus corporate events and private parties across Miami, Fort Lauderdale, Weston, and beyond.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="pad bg-ink">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow">The team bringing the magic ✨</span><h2 class="h-xl">Meet the crew.</h2><p class="lead" style="margin-inline:auto;">Behind every epic reception is a team that gets it. We’re more than DJs — we’re hosts, music curators, and party facilitators. And yeah, we kinda love what we do.</p></div>
      <div class="cards" style="grid-template-columns:repeat(4,1fr);">
        {team.map((m, i) => (
          <div class={`card reveal ${i ? 'd' + i : ''}`} style="aspect-ratio:3/4;">
            <img src={m.img} alt={m.name} />
            <div class="card-body"><h3 style="font-size:1.4rem;">{m.name}</h3><p style="max-height:none; opacity:1; color:#d9d0ec;">{m.role}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY BRIDES CHOOSE -->
  <section class="pad bg-light">
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow">Why brides choose Xpress 💖</span><h2 class="h-xl">6 Reasons We Might Be Your Perfect Wedding Team</h2></div>
      <div class="values">
        {reasons.map((r, i) => (
          <div class={`value reveal ${i % 3 === 1 ? 'd1' : i % 3 === 2 ? 'd2' : ''}`}><h3>{r.t}</h3><p>{r.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSING -->
  <section class="cta pad">
    <div class="wrap" style="max-width:820px;">
      <span class="eyebrow light reveal">Let's talk</span>
      <h2 class="display reveal d1">Ready to Make Your Event Unforgettable?</h2>
      <p class="lead reveal d2" style="margin:24px auto 0; text-align:center; color:#e9e2f5;">We’re excited to work with you! Whether you’re planning a wedding, corporate event, or party, Xpress Entertainment is here to bring your vision to life. Contact us today to learn more about our services or to schedule a consultation.</p>
      <div class="reveal d3" style="margin-top:36px;"><a href="/check-availability" class="btn"><span>Check Availability</span> <span class="arrow">↗</span></a></div>
    </div>
  </section>
</Base>
