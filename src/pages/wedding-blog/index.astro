---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import { phUri } from '../../lib/ph';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title="Wedding Blog | Xpress Entertainment — South Florida Wedding Tips" description="Music tips, planning advice, and South Florida wedding inspiration from the Xpress Entertainment team. Keep your dance floor packed and your day stress-free.">

  <Hero
    size="mid"
    eyebrow="Wedding Blog"
    titleHtml={`The Xpress<br>journal.`}
    sub="Music tips, planning advice, and South Florida wedding inspiration — love letters to couples who believe in the power of music to soundtrack their story."
    image={phUri(2560, 1440, 'Wedding Blog — hero', 'Editorial wedding / music vibe')}
    alt="Wedding blog"
  />

  <section class="pad bg-ink">
    <div class="wrap">
      <div class="cards">
        {posts.map((p, i) => (
          <a class={`card reveal ${i % 3 === 1 ? 'd1' : i % 3 === 2 ? 'd2' : ''}`} href={`/wedding-blog/${p.slug}`}>
            <img src={p.data.image} alt={p.data.title} />
            <span class="tag">{p.data.tag}</span>
            <div class="card-body">
              <h3 style="font-size:1.35rem;">{p.data.title}</h3>
              <p>{p.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTA eyebrow="Ready to plan?" titleHtml={`Let's talk<br>about your day.`} />
</Base>
