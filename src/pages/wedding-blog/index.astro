---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import BlogCarousel from '../../components/BlogCarousel.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const order = ['Music Tips', 'Wedding Tips', 'Planning', 'South Florida Wedding Venues'];
const byCat = {};
for (const p of posts) (byCat[p.data.tag] ||= []).push(p);
const cats = [
  ...order.filter((c) => byCat[c]),
  ...Object.keys(byCat).filter((c) => !order.includes(c)),
];
---
<Base title="Wedding Blog | Xpress Entertainment — South Florida Wedding Tips" description="Music tips, planning advice, and South Florida wedding inspiration from the Xpress Entertainment team. Keep your dance floor packed and your day stress-free.">

  <Hero
    size="mid"
    eyebrow="Wedding Blog"
    titleHtml={`The Xpress<br>journal.`}
    sub="Music tips, planning advice, and South Florida wedding inspiration — love letters to couples who believe in the power of music to soundtrack their story."
    image="/images/heroes/wedding-blog-hero.jpg"
    alt="Newlyweds sharing their first dance on the wedding dance floor"
    creditName="Romina Raggio Photography"
    creditHref="https://rominaraggio.com/"
  />

  <section class="pad bg-ink">
    {cats.map((c, i) => (
      <BlogCarousel title={c} posts={byCat[c]} hrefBase="/wedding-blog" reverse={i % 2 === 1} />
    ))}
  </section>

  <CTA eyebrow="Ready to plan?" titleHtml={`Let's talk<br>about your day.`} />
</Base>
