---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found (404) | Xpress Entertainment" description="This page took the night off. Head back to Xpress Entertainment — South Florida's award-winning wedding DJ & entertainment team.">

  <section class="pad bg-ink" style="min-height:100svh; display:flex; align-items:center; padding-top:120px;">
    <div class="wrap" style="text-align:center; max-width:680px;">
      <img src="/images/404.png" alt="Xpress Entertainment — page not found" style="display:block; width:min(320px, 68%); height:auto; margin:0 auto 18px;" />
      <span class="eyebrow" style="display:inline-block;">404 — Page not found</span>
      <h1 class="h-xl" style="margin:12px 0 16px;">This page took the night off.</h1>
      <p class="lead" style="margin:0 auto 32px;">Looks like the track you're after isn't on the setlist. Let's get you back to the party.</p>
      <div style="display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
        <a href="/" class="btn"><span>Back to Home</span> <span class="arrow">↗</span></a>
        <a href="/check-availability" class="btn ghost"><span>Check Availability</span></a>
      </div>
    </div>
  </section>
</Base>
