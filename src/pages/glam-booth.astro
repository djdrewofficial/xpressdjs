---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import FaqSchema from '../components/FaqSchema.astro';

const gallery = [1, 2, 3, 4, 5, 6].map((n) => ({
  src: `/images/galleries/glam-photo-booth-bw-0${n}.jpg`,
  alt: `Black and white glam portrait from the Xpress Entertainment Glam Booth at a South Florida wedding (${n} of 6)`,
}));

// Three step "how it works" beats — match what top glam booth providers
// emphasize: pose, ai beauty, instant share.
const steps = [
  ['01 · Step in', "Studio-grade lighting, a clean editorial backdrop, and a few seconds to give us your best face. That's it."],
  ['02 · Glam capture', "A crisp black-and-white portrait under high-fashion lighting, then a skin-smoothing pass that flatters everyone without erasing them."],
  ['03 · Instant share', "Tap a phone or scan a QR and the photo lands in your camera roll seconds later. Ready for the story."],
];

// Features grid — synthesized from what's selling on top glam booth pages
// (high-fashion lighting, AI beauty, b/w editorial, instant share, custom
// branding, attended).
const features = [
  ['📸 High-fashion lighting', "Studio key lighting and a clean backdrop that turn every guest into a magazine cover."],
  ['💎 AI skin smoothing', "A subtle beauty pass that makes everyone look their best. No filters that feel like filters."],
  ['🖤 Black & white finish', "Editorial, timeless, and your photographer will love the way it looks alongside their gallery."],
  ['📱 Instant text / AirDrop / QR', "No printing line, no waiting. The photo lands in your guests' phones in seconds."],
  ['🎀 Custom branded overlay', "Your monogram, hashtag, or event mark layered onto every photo. Built for your day."],
  ['👋 Stylist-attended', "A real human runs the booth, hypes your guests, and keeps the line moving."],
];

const occasions = ['Weddings', 'Sweet 16s & Quinces', 'Engagement Parties', 'Brand Activations', 'Corporate Galas', 'Influencer Events'];

const faqs = [
  { q: 'What is a Glam Booth?', a: "It's the high-fashion, editorial black-and-white photo booth you've seen at celebrity weddings and brand events. Your guests step in, strike a pose, and walk away with a stunning, share-ready glam portrait a few seconds later." },
  { q: "How is it different from a regular photo booth?", a: "A regular booth gives you fun group prints. A Glam Booth gives you editorial black-and-white portraits with high-fashion studio lighting and skin-smoothing AI. Different vibe, different result, often paired together at the same event." },
  { q: "Can we customize it for our event?", a: "Yes. We layer your monogram, hashtag, or event mark onto every photo, and we'll work with you on the backdrop so it fits the look of your venue." },
  { q: "Where do you offer the Glam Booth?", a: "All over South Florida: Miami, Fort Lauderdale, Palm Beach, the Keys, and everywhere in between." },
];
const faqItems = faqs.map((f) => ({ q: f.q, a: f.a }));
---
<Base
  title="Glam Booth | Black & White Glam Photo Booth — Xpress Entertainment"
  description="The Glam Booth from Xpress Entertainment: editorial black-and-white glam portraits with high-fashion studio lighting and AI skin-smoothing for weddings and events across South Florida.">

  <div class="glam-page">
    <Hero
      size="tall"
      eyebrow="Glam Booth"
      titleHtml={`Strike a pose.<br><span class="serif-accent" style="font-style:italic">In black and white.</span>`}
      sub="Editorial black-and-white glam portraits with high-fashion studio lighting and skin-smoothing AI. The kind of guest experience your friends will be reposting for a week."
      image="/images/galleries/glam-photo-booth-bw-cover.jpg"
      alt="A wedding guest captured in a black-and-white glam booth portrait by Xpress Entertainment"
      ctaText="Add It to Your Event"
    />

    <!-- INTRO -->
    <section class="pad bg-ink">
      <div class="wrap" style="max-width:880px;">
        <p class="lead reveal" style="text-align:center;">Think Met Gala. Think the black-and-white glam portrait everyone takes home from a celebrity wedding. We bring that booth to your event with studio lighting, an AI beauty pass, and instant phone delivery so your guests have their photo in their camera roll before the next song drops.</p>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="pad bg-deep">
      <div class="wrap">
        <div class="sec-head center reveal"><span class="eyebrow light">How it works</span><h2 class="h-xl">A few seconds, one stunning photo.</h2></div>
        <div class="values" style="grid-template-columns:repeat(3,1fr);">
          {steps.map(([t, d], i) => (
            <div class={`value reveal ${['', 'd1', 'd2'][i]}`} style="border-color:rgba(255,255,255,0.14); color:#fff;">
              <h3 style="font-family:var(--serif); font-size:1.5rem;">{t}</h3>
              <p style="color:#d9d0ec; margin-top:10px;">{d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- THE LOOK (gallery strip) -->
    <section class="pad bg-ink">
      <div class="wrap">
        <div class="sec-head reveal"><span class="eyebrow">The look</span><h2 class="h-xl">Editorial. Timeless. Instantly shareable.</h2></div>
        <div class="glam-grid">
          {gallery.map((g, i) => (
            <div class={`media reveal ${['','d1','d2','','d1','d2'][i]}`}>
              <img src={g.src} alt={g.alt} loading="lazy" />
              <span class="cam-flash" aria-hidden="true"></span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="pad bg-deep">
      <div class="wrap">
        <div class="sec-head center reveal"><span class="eyebrow light">What's in the box</span><h2 class="h-xl">Built like a magazine spread.</h2></div>
        <div class="values" style="grid-template-columns:repeat(2,1fr);">
          {features.map(([t, d], i) => (
            <div class={`value reveal ${i % 2 ? 'd1' : ''}`} style="border-color:rgba(255,255,255,0.14); color:#fff;">
              <h3>{t}</h3>
              <p style="color:#d9d0ec;">{d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- BUILT FOR -->
    <section class="pad bg-ink">
      <div class="wrap" style="max-width:920px;">
        <div class="sec-head center reveal"><span class="eyebrow">Built for</span><h2 class="h-xl">The kind of nights people post about.</h2></div>
        <ul class="glam-occasions reveal">
          {occasions.map((o) => <li>{o}</li>)}
        </ul>
      </div>
    </section>

    <!-- PAIR IT WITH -->
    <section class="pad bg-deep">
      <div class="wrap">
        <div class="split">
          <div class="reveal">
            <span class="eyebrow light">Pair it with</span>
            <h2 class="h-lg" style="margin:14px 0 16px; color:#fff;">A classic photo booth too.</h2>
            <p class="lead" style="color:#d9d0ec;">The Glam Booth gives every guest their solo moment. A traditional booth gives you the goofy group prints to take home. Couples often book both and place them on opposite sides of the room so the line keeps moving.</p>
            <div style="margin-top:24px; display:flex; gap:12px; flex-wrap:wrap;">
              <a href="/south-florida-photo-booth-rental" class="btn"><span>See Our Photo Booths</span> <span class="arrow">↗</span></a>
              <a href="/epic-extras-1" class="btn ghost"><span>Epic Extras</span></a>
            </div>
          </div>
          <div class="media reveal d1"><img src="/images/galleries/glam-photo-booth-bw-07.jpg" alt="Couple sharing a moment in the Xpress Entertainment Glam Booth" loading="lazy" /></div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pad bg-ink">
      <div class="wrap" style="max-width:880px;">
        <div class="sec-head center reveal"><span class="eyebrow">Good to know</span><h2 class="h-xl">Glam Booth FAQs.</h2></div>
        <div style="display:flex; flex-direction:column; gap:18px;">
          {faqs.map((f, i) => (
            <div class={`value reveal ${i % 2 ? 'd1' : ''}`} style="border-color:rgba(255,255,255,0.14); color:#fff;">
              <h3 style="font-size:1.15rem;">{f.q}</h3>
              <p style="color:#d9d0ec; margin-top:8px;">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <FaqSchema items={faqItems} />

    <CTA eyebrow="🤍 Ready for the glam moment?" titleHtml={`Add the Glam Booth<br>to your day.`} text="Tell us your date and venue. We'll handle the glam part." />
  </div>

  <script is:inline>
    (function () {
      try {
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var flashes = [].slice.call(document.querySelectorAll('.glam-grid .cam-flash'));
        if (!flashes.length) return;
        var corners = ['c-tl', 'c-tr', 'c-bl', 'c-br'];
        var last = -1;
        function pop() {
          if (document.hidden) return; // pause when tab not visible
          var i = Math.floor(Math.random() * flashes.length);
          if (flashes.length > 1 && i === last) i = (i + 1) % flashes.length;
          last = i;
          var el = flashes[i];
          el.className = 'cam-flash ' + corners[Math.floor(Math.random() * corners.length)];
          void el.offsetWidth; // restart the animation
          el.classList.add('go');
        }
        setTimeout(pop, 900);
        setInterval(pop, 2000);
      } catch (e) {}
    })();
  </script>
</Base>

<style is:global>
  /* The drain. On load the page is faintly tinted, then saturation falls to
     zero over ~3.6s while a colored "wave" line slides from the top of the
     viewport to the bottom. After it settles, the page lives in monochrome —
     fitting for the Glam Booth product. */
  .glam-page { animation: glam-saturate 3.6s cubic-bezier(.7,.05,.4,1) 0.3s forwards; }
  @keyframes glam-saturate {
    0%   { filter: saturate(1.08) contrast(1.02); }
    100% { filter: saturate(0)    contrast(1.06); }
  }

  .glam-page::before {
    content: "";
    position: fixed; left: 0; right: 0; top: 0; height: 6px;
    background: linear-gradient(90deg, var(--red) 0%, #DBAAE1 50%, var(--red) 100%);
    box-shadow: 0 0 28px rgba(254, 58, 59, 0.55), 0 0 14px rgba(219, 170, 225, 0.45);
    z-index: 1000; pointer-events: none;
    animation: glam-wave 3.6s cubic-bezier(.7,.05,.4,1) 0.3s forwards;
  }
  @keyframes glam-wave {
    0%   { top: 0;        opacity: 1; }
    92%  {                opacity: 1; }
    100% { top: 100svh;   opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .glam-page { animation: none; filter: saturate(0) contrast(1.06); }
    .glam-page::before { display: none; }
  }
</style>

<style>
  .glam-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 28px;
  }
  .glam-grid .media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 12px; background: #0a0612; }
  .glam-grid .media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s var(--ease); }
  .glam-grid .media:hover img { transform: scale(1.04); }
  @media (max-width: 860px) { .glam-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .glam-grid { grid-template-columns: 1fr; } }

  /* Camera flash pops — one random image at a time (see inline script) */
  .cam-flash {
    position: absolute; width: 52px; height: 52px; border-radius: 50%;
    pointer-events: none; opacity: 0; z-index: 3; mix-blend-mode: screen;
    background: radial-gradient(circle, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.45) 32%, transparent 70%);
  }
  .cam-flash.c-tl { top: 9px; left: 9px; }
  .cam-flash.c-tr { top: 9px; right: 9px; }
  .cam-flash.c-bl { bottom: 9px; left: 9px; }
  .cam-flash.c-br { bottom: 9px; right: 9px; }
  .cam-flash.go { animation: cam-pop 620ms ease-out; }
  @keyframes cam-pop {
    0%   { opacity: 0;   transform: scale(0.35); }
    16%  { opacity: 0.98; transform: scale(1.15); }
    38%  { opacity: 0.45; transform: scale(1); }
    100% { opacity: 0;   transform: scale(1.25); }
  }
  @media (prefers-reduced-motion: reduce) { .cam-flash { display: none; } }

  .glam-occasions {
    list-style: none; padding: 0; margin: 28px 0 0;
    display: flex; flex-wrap: wrap; gap: 10px; justify-content: center;
  }
  .glam-occasions li {
    padding: 10px 18px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.18);
    color: #fff; font-size: 0.95rem; letter-spacing: 0.02em;
    background: rgba(255,255,255,0.04);
  }
</style>
