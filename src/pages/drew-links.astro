---
<Base title="Drew Segura · Links" description="Drew Segura — founder & lead DJ at Xpress Entertainment. Book a consult, check availability, listen to mixes, and follow Drew across socials." noindex={true}>

  <main class="link-tree">
    <div class="lt-wrap">
      <div class="lt-avatar">
        <img src="/images/djs/drew-segura-headshot.png" alt="Drew Segura — founder & lead DJ, Xpress Entertainment" />
      </div>
      <h1 class="lt-name">Drew Segura</h1>
      <p class="lt-tagline">Founder & Lead DJ</p>
      <p class="lt-sub">Xpress Entertainment · South Florida</p>

      <div class="lt-buttons">
        {links.map((l) => (
          <a href={l.href} class={`lt-btn ${l.primary ? 'primary' : ''}`}>
            <span class="lt-emo">{l.emoji}</span>
            <span class="lt-text">{l.label}</span>
            <span class="lt-arrow">↗</span>
          </a>
        ))}
      </div>

      <div class="lt-socials">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="lt-social" aria-label={`Drew Segura on ${s.label}`}>
            <span class="lt-social-icon" set:html={s.svg} />
          </a>
        ))}
      </div>

      <p class="lt-foot">© <span data-year>2026</span> Xpress Entertainment Corp.</p>
    </div>
  </main>

  <style is:global>
    body:has(.link-tree) nav.nav,
    body:has(.link-tree) footer,
    body:has(.link-tree) .lang-toggle { display: none !important; }
    body:has(.link-tree) { background: radial-gradient(ellipse at top, #1a112d 0%, #0a0612 70%) fixed; }
  </style>

  <style>
    .link-tree { min-height: 100svh; display: flex; align-items: flex-start; justify-content: center; padding: 56px 22px 80px; }
    .lt-wrap { width: 100%; max-width: 440px; text-align: center; }

    .lt-avatar {
      width: 132px; height: 132px; margin: 0 auto 18px;
      border-radius: 50%; overflow: hidden;
      border: 3px solid rgba(255,255,255,0.18);
      box-shadow: 0 16px 40px rgba(0,0,0,0.5), 0 0 0 4px rgba(254, 58, 59, 0.18);
      background: #17112a;
    }
    .lt-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .lt-name { font-family: var(--serif); font-size: 2.2rem; color: #fff; margin: 0 0 4px; line-height: 1.1; letter-spacing: 0.01em; }
    .lt-tagline { font-family: var(--serif); font-style: italic; font-size: 1.15rem; color: var(--lavender); margin: 0 0 6px; }
    .lt-sub { color: var(--muted); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 30px; }

    .lt-buttons { display: flex; flex-direction: column; gap: 12px; margin: 0 0 32px; }
    .lt-btn {
      display: flex; align-items: center; gap: 12px;
      padding: 16px 18px; border-radius: 14px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.12);
      color: #fff; text-decoration: none; font-weight: 600;
      transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
      -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    }
    .lt-btn:hover { transform: translateY(-2px); background: rgba(255,255,255,0.09); border-color: rgba(255,255,255,0.24); }
    .lt-btn.primary { background: var(--red); border-color: transparent; box-shadow: 0 12px 30px rgba(254, 58, 59, 0.35); }
    .lt-btn.primary:hover { background: #ff5152; }
    .lt-emo { font-size: 1.15rem; line-height: 1; flex-shrink: 0; }
    .lt-text { flex: 1; text-align: left; font-size: 0.98rem; }
    .lt-arrow { opacity: 0.55; font-size: 0.95rem; }

    .lt-socials { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; margin: 0 0 26px; }
    .lt-social {
      width: 44px; height: 44px; border-radius: 50%;
      display: inline-flex; align-items: center; justify-content: center;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.14);
      color: #fff; text-decoration: none;
      transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
    }
    .lt-social:hover { transform: translateY(-2px); background: var(--red); border-color: transparent; color: #fff; }
    .lt-social-icon { display: inline-flex; }
    .lt-social-icon :global(svg) { width: 20px; height: 20px; display: block; }

    .lt-foot { color: var(--muted); font-size: 0.74rem; margin-top: 14px; letter-spacing: 0.05em; }

    @media (max-width: 420px) {
      .lt-avatar { width: 116px; height: 116px; }
      .lt-name { font-size: 1.85rem; }
      .lt-tagline { font-size: 1.05rem; }
      .lt-text { font-size: 0.92rem; }
    }
  </style>
</Base>
