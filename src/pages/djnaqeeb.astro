---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import Ph from '../components/Ph.astro';
import { phUri } from '../lib/ph';

const why = [
  ['🌴 West Indian & Caribbean expert', 'Soca, dancehall, reggae, calypso, chutney and Afrobeats are home base. He knows the songs, the moments, and the order they belong in.'],
  ['🎚️ Open-format mixer', 'Blends Caribbean sound with hip-hop, R&B, Latin and top 40 so every guest in the room hears something they love.'],
  ['🎤 Smooth MC', 'Hits every cue, owns the mic when it counts, and steps back when the moment belongs to you.'],
  ['🔥 Built for big dance floors', 'Long sets, big drops, and the kind of energy your guests are still texting you about a week later.'],
];
---
<Base
  title="DJ Naqeeb | West Indian & Caribbean Wedding DJ in Miami — Xpress Entertainment"
  description="DJ Naqeeb — West Indian and Caribbean wedding DJ based in Miami and Fort Lauderdale. Soca, dancehall, Afrobeats, hip-hop and top 40 for South Florida weddings.">

  <Hero
    eyebrow="West Indian Wedding DJ · Miami & Fort Lauderdale"
    titleHtml={`DJ Naqeeb`}
    sub="Caribbean roots, open-format chops, and a packed dance floor every time. DJ Naqeeb brings the soca, dancehall, Afrobeats and cross-cultural energy South Florida weddings are built for."
    image={phUri(2560, 1440, 'DJ Naqeeb — hero', 'Caribbean wedding dance floor or wide shot of DJ Naqeeb mixing at a Miami wedding')}
    alt="DJ Naqeeb spinning at a South Florida wedding reception"
    ctaText="Check Availability"
  />

  <section class="pad bg-ink">
    <div class="wrap">
      <div class="split">
        <div class="media reveal" style="background:var(--ink-2);"><img src="/images/djs/naqeeb-mohamed-headshot.jpg" alt="DJ Naqeeb — West Indian and Caribbean wedding DJ in Miami and Fort Lauderdale" style="aspect-ratio:1; object-fit:cover; width:100%; height:100%;" /></div>
        <div class="reveal d1">
          <span class="eyebrow">🌴 Caribbean Wedding DJ rooted in South Florida</span>
          <h2 class="h-lg" style="margin:14px 0 18px;">A wedding that sounds like home.</h2>
          <p class="lead">Born into the West Indian tradition and based in South Florida, DJ Naqeeb knows how to throw a Caribbean wedding. From the first soca drop to the late-night dancehall set, he understands the music, the moments, and the culture behind them.</p>
          <p class="lead" style="margin-top:14px;">Whether your wedding is fully West Indian, a mixed-culture celebration, or you just want a DJ who can pivot between Caribbean, Latin, hip-hop and top 40 without missing a beat, Naqeeb reads the floor and keeps it moving from cocktail hour to last dance.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="pad bg-deep">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow light">🔥 Why couples book DJ Naqeeb</span><h2 class="h-xl">A sound for every guest.</h2></div>
      <div class="values" style="grid-template-columns:repeat(2,1fr);">
        {why.map(([t, d], i) => (
          <div class={`value reveal ${i % 2 ? 'd1' : ''}`} style="border-color:rgba(255,255,255,0.14); color:#fff;"><h3>{t}</h3><p style="color:#d9d0ec;">{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="showcase">
    <Ph w={2400} h={1400} label="DJ Naqeeb — packed dance floor" note="Wide shot of a Caribbean wedding dance floor at peak energy" />
    <div class="wrap" style="max-width:900px;"><blockquote class="reveal" style="max-width:none; font-size:clamp(1.4rem,3vw,2.4rem);">Soca, dancehall, Afrobeats, top 40. Every culture in the room hears their song.</blockquote></div>
  </section>

  <section class="pad bg-ink">
    <div class="wrap" style="max-width:880px;">
      <div class="sec-head reveal" style="max-width:none;"><span class="eyebrow">Beyond the Booth</span><h2 class="h-lg">A Wedding DJ Who Respects the Culture</h2></div>
      <p class="lead reveal d1">Off the booth, Naqeeb is the calm presence who shows up early, sets up clean, and makes the night feel effortless. He has the experience to handle whatever the wedding throws at him, and the taste to make sure the music tells the story you want told.</p>
      <ul class="reveal d2" style="margin:22px 0 0 20px; color:#d9d0ec; line-height:2;">
        <li>🌴 Deep Caribbean catalog: soca, dancehall, reggae, Afrobeats, calypso</li>
        <li>🎚️ Open-format fluency across hip-hop, R&B, Latin and top 40</li>
        <li>✨ A calm, professional presence from setup to last dance</li>
        <li>🖤 A real respect for the culture behind every song</li>
      </ul>
      <p class="lead reveal d2" style="margin-top:18px; color:#fff;">With Naqeeb behind the booth, you get a DJ who reads the room, honors the culture, and keeps your dance floor packed all night.</p>
    </div>
  </section>

  <CTA eyebrow="Book DJ Naqeeb" titleHtml={`Bring the Caribbean<br>to your dance floor.`} />
</Base>
