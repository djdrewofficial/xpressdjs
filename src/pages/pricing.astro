---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';

const extras = [
  'Ceremony Coverage',
  'Uplighting (Set of 10)',
  'Monogram Projection',
  'Cold Spark Machines (Pair of 2)',
  'Dancing on the Clouds',
  'Club Style Light Show',
  'CO2 Hand Guns',
  'CO2 Cannons',
  'The Ultimate Laser Experience',
];
const lux = ['Canon DSLR Camera', 'Delivery & Breakdown', 'Unlimited Photo Sessions + Prints', 'Studio Flash', 'Quality Props', 'Instant Prints', 'Online Gallery', 'Text Message Sharing', 'Photobooth Attendant'];
const threesixty = ['360 Booth', 'Delivery & Breakdown', 'Unlimited Video Sessions', 'Studio Lighting', 'Red & Gold Stanchions', 'Social Sharing', 'Text Message Sharing', 'Photobooth Attendant'];
---
<Base title="Wedding DJ Pricing | Xpress Entertainment — South Florida" description="How much do wedding DJs cost? Most couples spend between $1,750 and $3,500. Meet our DJs, see their rates, and build your Ultimate Wedding Experience.">

  <Hero
    size="mid"
    eyebrow="Transparent pricing"
    titleHtml={`How Much Do<br>Wedding DJs <span class="serif-accent" style="font-style:italic">Cost?</span>`}
    sub="Your wedding is not a package. It is an experience, and the DJ you choose plays a huge role in how the entire night feels."
    image="/images/heroes/pricing-hero.jpg"
    alt="Newlyweds singing along to the music on the wedding dance floor"
    ctaText="Check Your Date"
    creditName="Sid Rashlich"
    creditHref="https://photovsl.com/"
  />

  <section class="pad bg-ink">
    <div class="wrap" style="max-width:880px;">
      <p class="lead reveal">At Xpress Entertainment, we built our pricing around a simple idea. Every DJ has their own personality, background, and level of demand, and the price reflects the experience they bring to your celebration.</p>
      <p class="lead reveal d1" style="margin-top:16px;">Most couples spend between $1,750 and $3,500, with our newer, in-demand DJs starting on the lower end and our most requested, highly experienced DJs at the top. This gives you the freedom to choose the person who aligns with your vision and the energy you want for your wedding day.</p>
      <p class="lead reveal d2" style="margin-top:16px; color:#fff;">👉 Scroll down to meet the DJs, see their rates, and start building your version of The Ultimate Wedding Experience.</p>
    </div>
  </section>

  <!-- DJ PRICING -->
  <section class="pad bg-deep">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow light">Meet the DJs</span><h2 class="h-xl">Choose your DJ.</h2></div>
      <div class="cards">
        <div class="value reveal" style="border-color:rgba(255,255,255,0.14); color:#fff; text-align:center;">
          <img src="/images/djs/drew-segura-headshot.png" alt="Drew Segura — founder & lead DJ" class="dj-avatar" />
          <h3>Drew Segura</h3>
          <p style="color:#d9d0ec; margin:12px 0;">A bilingual Wedding DJ & MC with roots in American, Dominican & Colombian cultures. Known for his phenomenal hosting skills and blending cultures seamlessly.</p>
          <div style="font-family:var(--serif); font-size:2.4rem; color:var(--red);">Starting at $2,500</div>
          <a href="/dj-drew-segura" class="textlink" style="margin-top:16px;">Learn More About Drew ↗</a>
        </div>
        <div class="value reveal d1" style="border-color:rgba(255,255,255,0.14); color:#fff; text-align:center;">
          <img src="/images/djs/dj-phil-headshot.jpg" alt="DJ Phil — wedding DJ & MC" class="dj-avatar" />
          <h3>DJ Phil</h3>
          <p style="color:#d9d0ec; margin:12px 0;">A versatile open-format DJ & MC who reads the room effortlessly and blends genres to keep every generation on the dance floor all night long.</p>
          <div style="font-family:var(--serif); font-size:2.4rem; color:var(--red);">Starting at $2,500</div>
          <a href="/djphil" class="textlink" style="margin-top:16px;">Learn More About Phil ↗</a>
        </div>
        <div class="value reveal d2" style="border-color:rgba(255,255,255,0.14); color:#fff; text-align:center;">
          <img src="/images/djs/dj-rere-headshot.jpg" alt="DJ ReRe — wedding DJ & MC" class="dj-avatar" />
          <h3>DJ ReRe</h3>
          <p style="color:#d9d0ec; margin:12px 0;">An energetic DJ & MC who brings the hype and the heart, curating a soundtrack that fits your crowd and keeps the celebration moving.</p>
          <div style="font-family:var(--serif); font-size:2.4rem; color:var(--red);">Starting at $2,500</div>
          <a href="/services/djs" class="textlink" style="margin-top:16px;">Meet the Team ↗</a>
        </div>
      </div>
      <p class="lead reveal" style="text-align:center; margin-top:30px; color:var(--lavender);">(Pricing includes Cocktail Hour & Reception)</p>
    </div>
  </section>

  <!-- EPIC EXTRAS -->
  <section class="pad bg-ink">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow">Epic Extras (Addons)</span><h2 class="h-xl">Elevate the experience.</h2><p class="lead" style="margin-inline:auto;">A great entertainer is the first step in creating an epic dancefloor at your wedding. These Epic Extras will elevate your Ultimate Wedding Experience.</p></div>
      <div class="reveal" style="max-width:680px; margin:0 auto;">
        {extras.map((name) => (
          <div style="display:flex; align-items:center; gap:16px; padding:18px 0; border-bottom:1px solid rgba(255,255,255,0.12);">
            <span style="color:var(--red); font-family:var(--serif);">✦</span><span style="font-size:1.15rem;">{name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PHOTOBOOTHS -->
  <section class="pad bg-deep">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow light">Photobooth Packages</span><h2 class="h-xl">Tap, Pose, Smile – Repeat.</h2></div>
      <div class="cards" style="grid-template-columns:repeat(2,1fr);">
        <div class="value reveal" style="border-color:rgba(255,255,255,0.14); color:#fff; text-align:center;">
          <h3>Lux Photo-Booth</h3>
          <div style="font-family:var(--serif); font-size:2.4rem; color:var(--red); margin:8px 0;">$875</div>
          <p style="color:var(--lavender); margin-bottom:14px;">4 Hours</p>
          <ul style="list-style:none; color:#d9d0ec; line-height:1.9; padding:0; text-align:left; display:inline-block;">{lux.map((i) => <li>✦ {i}</li>)}</ul>
        </div>
        <div class="value reveal d1" style="border-color:rgba(255,255,255,0.14); color:#fff; text-align:center;">
          <h3>360 Video Booth</h3>
          <div style="font-family:var(--serif); font-size:2.4rem; color:var(--red); margin:8px 0;">$1,250</div>
          <p style="color:var(--lavender); margin-bottom:14px;">4 Hours</p>
          <ul style="list-style:none; color:#d9d0ec; line-height:1.9; padding:0; text-align:left; display:inline-block;">{threesixty.map((i) => <li>✦ {i}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <CTA eyebrow="Build your night" titleHtml={`Build your Ultimate<br>Wedding Experience.`} ctaText="Check Availability" />
</Base>
