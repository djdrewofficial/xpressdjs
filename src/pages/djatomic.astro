---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import VideoLightbox from '../components/VideoLightbox.astro';
import SocialFollow from '../components/SocialFollow.astro';

const socials = [
  { platform: 'instagram', url: 'https://instagram.com/djatomicentertainment', handle: '@djatomicentertainment' },
];

const why = [
  ['🎤 Charismatic MC & crowd motivator', 'Brings the energy and keeps your guests engaged from the first announcement to the last song.'],
  ['🎚️ Open-format mixing across cultures', 'Seamlessly blends genres like Reggaeton, Soca, Top 40, Hip-Hop, EDM, and more—customized for your crowd.'],
  ['🌍 Proven Global DJ Experience', 'From Saint Lucia to South Florida, he’s rocked stages around the world and knows how to tailor music to any audience.'],
  ['🔊 Seamless Music from ‘I Do’ to Last Dance', 'No awkward silences, no missed moments—just smooth transitions and nonstop good energy.'],
];
---
<Base title="DJ Atomic | International Wedding & Event DJ in South Florida — Xpress Entertainment" description="DJ Atomic — international wedding & event DJ based in South Florida. 600+ events, multicultural style, flawless mixing, and the ability to read any room.">

  <Hero
    eyebrow="South Florida's Wedding & Event DJ"
    titleHtml={`DJ <span class="serif-accent" style="font-style:italic">Atomic</span>`}
    sub="From luxury cruise ships to unforgettable South Florida weddings, DJ Atomic brings global experience and high-energy vibes to every celebration."
    image="/images/heroes/dj-atomic-hero.jpg"
    alt="DJ Atomic — Miami & Fort Lauderdale wedding DJ & MC"
    ctaText="Check Availability"
    creditName="Leo Photographer"
    creditHref="https://leophotographer.com"
  />

  <section class="pad bg-ink">
    <div class="wrap">
      <div class="split rev">
        <div class="media reveal" style="background:var(--ink-2);"><img src="/images/djs/dj-atomic-headshot.jpg" alt="DJ Atomic headshot — Miami & Fort Lauderdale wedding DJ & MC" style="aspect-ratio:1; object-fit:cover; width:100%; height:100%;" /></div>
        <div class="reveal d1">
          <span class="eyebrow">🌍 International Wedding & Event DJ Based in South Florida</span>
          <h2 class="h-lg" style="margin:14px 0 18px;">Over 600 Unforgettable Weddings</h2>
          <p class="lead">With a track record of over 600 weddings and events, DJ Atomic brings an elite level of experience to every celebration. From cruise ships and luxury resorts to vibrant South Florida weddings and international stages, he’s not just a DJ—he’s a world-class entertainer with a local heartbeat.</p>
          <p class="lead" style="margin-top:14px;">Originally from Saint Lucia and now based in South Florida, DJ Atomic is known for his multicultural music style, flawless mixing, and ability to read any room. Whether it’s a beachfront ceremony, a chic ballroom reception, or a destination wedding, he creates a high-energy soundtrack that keeps your guests dancing all night long.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="pad bg-deep">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow light">🔥 Why Couples & Event Planners Book DJ Atomic</span><h2 class="h-xl">A world-class entertainer.</h2></div>
      <div class="values" style="grid-template-columns:repeat(2,1fr);">
        {why.map(([t, d], i) => (
          <div class={`value reveal ${i % 2 ? 'd1' : ''}`} style="border-color:rgba(255,255,255,0.14); color:#fff;"><h3>{t}</h3><p style="color:#d9d0ec;">{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="pad bg-deep">
    <div class="wrap" style="max-width:1040px;">
      <div class="sec-head center reveal"><span class="eyebrow light">▶ Watch the Xperience</span><h2 class="h-xl">See Atomic live.</h2></div>
      <div class="video-grid">
        <VideoLightbox compact id="kH4JBmuWiHc" label="DJ Atomic — live wedding highlight" />
        <VideoLightbox compact class="d1" id="VZIEL4B_y4c" label="DJ Atomic — live wedding highlight" />
      </div>
      <blockquote class="reveal d1" style="font-family:var(--serif); font-size:clamp(1.4rem,3vw,2.2rem); color:var(--lavender); text-align:center; max-width:880px; margin:40px auto 0; line-height:1.4;">A World of Sound, One Packed Dance Floor — Soca, Reggaeton, R&B, and 70s throwbacks, curating the perfect mix all night long.</blockquote>
    </div>
  </section>

  <section class="pad bg-ink">
    <div class="wrap" style="max-width:880px;">
      <div class="sec-head reveal" style="max-width:none;"><span class="eyebrow">Beyond the Booth</span><h2 class="h-lg">A Wedding DJ with Global Soul</h2></div>
      <p class="lead reveal d1">Off the stage, DJ Atomic is more than just a music pro—he’s a storyteller and vibe curator. With roots in Saint Lucia and years of wedding experience across luxury resorts, destination venues, and South Florida hotspots, Atomic brings a global perspective to every couple’s big day.</p>
      <ul class="reveal d2" style="margin:22px 0 0 20px; color:#d9d0ec; line-height:2;"><li>🎶 A deep understanding of wedding moments—from ceremony to last dance</li><li>🌎 Global music knowledge with a personal touch</li><li>✨ A calm, professional presence that helps couples feel at ease</li><li>🖤 A passion for creating soundtracks that reflect your love story</li></ul>
      <p class="lead reveal d2" style="margin-top:18px; color:#fff;">With Atomic behind the booth, you’re not just booking a DJ—you’re bringing heart, energy, and unforgettable memories to your wedding day.</p>
    </div>
  </section>

  <SocialFollow name="DJ Atomic" links={socials} />

  <CTA eyebrow="Book DJ Atomic" titleHtml={`An unforgettable<br>experience.`} />
</Base>
