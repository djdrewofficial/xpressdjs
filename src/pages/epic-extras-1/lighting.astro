---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import Ph from '../../components/Ph.astro';
import { phUri } from '../../lib/ph';
---
<Base title="Wedding Lighting Add-Ons | Uplighting, Monogram & Light Shows — Xpress Entertainment" description="Lighting transforms a simple space into an elegant, vibrant celebration. Uplighting, personalized monogram projections, and high-energy club-style light shows for South Florida weddings.">

  <Hero
    size="mid"
    eyebrow="Epic Extras"
    titleHtml={`Lighting Add-Ons<br>for Your Wedding`}
    sub="Lighting plays a crucial role in setting the mood for your wedding, transforming a simple space into an elegant, vibrant celebration."
    image={phUri(2560, 1440, 'Lighting — hero', 'Uplit reception / colorful wedding lighting')}
    alt="Wedding uplighting"
    ctaText="Check Availability"
  />

  <section class="pad bg-ink">
    <div class="wrap" style="max-width:880px;">
      <p class="lead reveal">At Xpress Entertainment, we offer a range of lighting add-ons that bring your wedding vision to life. From romantic uplights to personalized monogram projections and high-energy club-style light shows, our lighting options create the perfect ambiance from start to finish.</p>
      <p class="lead reveal d1" style="margin-top:14px;">Whether you want to enhance the elegance of your reception or turn your dance floor into a nightclub-style experience, our professional lighting services are designed to match your style and theme.</p>
    </div>
  </section>

  <section class="pad bg-deep">
    <div class="wrap">
      <div class="split">
        <div class="media reveal"><Ph w={1200} h={900} label="Uplighting" note="Uplights glowing on venue walls" /></div>
        <div class="reveal d1">
          <span class="eyebrow light">Uplighting</span>
          <h2 class="h-lg" style="margin:14px 0 16px;">Set the Mood for Elegance</h2>
          <p class="lead">Strategically placed around the room, uplights cast a beautiful glow on walls, columns, and decor, transforming your space into a breathtaking environment — customized to match your wedding colors.</p>
          <ul style="margin:18px 0 0 20px; color:#d9d0ec; line-height:1.9;"><li><strong style="color:#fff;">Customizable Colors:</strong> match your wedding’s theme or create a specific atmosphere.</li><li><strong style="color:#fff;">Room Transformation:</strong> highlights architectural features and adds depth to your venue.</li><li><strong style="color:#fff;">Perfect for Photos:</strong> a beautiful backdrop for the cake cutting, toasts, and first dance.</li></ul>
        </div>
      </div>
    </div>
  </section>

  <section class="pad bg-ink">
    <div class="wrap">
      <div class="split rev">
        <div class="media reveal"><Ph w={1200} h={900} label="Monogram projection" note="Custom monogram on dance floor / wall" /></div>
        <div class="reveal d1">
          <span class="eyebrow">Monogram Projections</span>
          <h2 class="h-lg" style="margin:14px 0 16px;">Personalize Your Big Day</h2>
          <p class="lead">We can project your initials, wedding date, or custom design onto the dance floor, walls, or ceiling, adding a personal touch to your wedding décor — fully customizable to fit your style.</p>
          <ul style="margin:18px 0 0 20px; color:var(--muted); line-height:1.9;"><li><strong style="color:#fff;">Personalized Touch:</strong> your names, wedding date, or a custom design for a one-of-a-kind statement.</li><li><strong style="color:#fff;">Versatile Placement:</strong> dance floor, behind the sweetheart table, or the ceiling.</li><li><strong style="color:#fff;">Elegant & Unique:</strong> personalize your space without overwhelming the decor.</li></ul>
        </div>
      </div>
    </div>
  </section>

  <section class="pad bg-deep">
    <div class="wrap">
      <div class="split">
        <div class="media reveal"><Ph w={1200} h={900} label="Club-style light show" note="Moving heads / lasers on a packed floor" /></div>
        <div class="reveal d1">
          <span class="eyebrow light">Club-Style Light Show</span>
          <h2 class="h-lg" style="margin:14px 0 16px;">Bring the Party to Life</h2>
          <p class="lead">Moving heads, lasers, and colored LED lights sync with the music to create a nightclub experience your guests will never forget.</p>
          <ul style="margin:18px 0 0 20px; color:#d9d0ec; line-height:1.9;"><li><strong style="color:#fff;">High-Energy Atmosphere:</strong> transforms your dance floor into a vibrant, energetic space.</li><li><strong style="color:#fff;">Syncs with Music:</strong> lights move and change in sync with the beat.</li><li><strong style="color:#fff;">Customizable Effects:</strong> from soft glows to pulsing strobes and lasers.</li></ul>
        </div>
      </div>
    </div>
  </section>

  <CTA eyebrow="Contact us for lighting add-ons" titleHtml={`Light up<br>your day.`} />
</Base>
