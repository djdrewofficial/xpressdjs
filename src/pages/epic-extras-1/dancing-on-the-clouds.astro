---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import CTA from '../../components/CTA.astro';
import { phUri } from '../../lib/ph';

const why = [
  ['Romantic Ambiance', 'The low-lying fog creates a dreamy, romantic atmosphere, perfect for your first dance or any key moment during your wedding.'],
  ['Safe & Non-Slip', 'Our dry ice machine produces a fog that stays on the ground, avoiding the risks of slippery floors or obscuring your guests’ view.'],
  ['Perfect for Photos', 'This effect looks incredible in photos, giving you stunning images that will be cherished forever.'],
  ['Versatile for Multiple Moments', 'Often used for the first dance, it can also enhance grand entrances, special toasts, or your wedding exit.'],
];
---
<Base title="Dancing on the Clouds | First Dance Cloud Effect — Xpress Entertainment" description="Dancing on the Clouds for your South Florida wedding — a professional dry-ice machine creates a low-lying cloud so you feel like you're floating on air during your first dance.">

  <Hero
    size="mid"
    eyebrow="Epic Extras"
    titleHtml={`Dancing on Clouds for<br>Your <span class="serif-accent" style="font-style:italic">Dream Wedding</span>`}
    sub="Imagine your first dance as newlyweds, surrounded by a romantic, ethereal cloud that makes you feel like you’re floating on air."
    image={phUri(2560, 1440, 'Dancing on the Clouds — hero', 'First dance on low-lying cloud fog')}
    alt="Dancing on the clouds first dance"
    ctaText="Check Availability"
  />

  <section class="pad bg-ink">
    <div class="wrap" style="max-width:880px;">
      <p class="lead reveal">With Dancing on the Clouds from Xpress Entertainment, this magical moment can be yours. Our professional-grade dry ice machine creates a stunning low-lying fog that stays close to the floor, giving the illusion that you’re dancing on a soft, fluffy cloud.</p>
      <p class="lead reveal d1" style="margin-top:14px;">Perfect for weddings, this effect adds a touch of fantasy and elegance to your special day. Whether it’s for your first dance, a grand entrance, or even during a special moment like the cake cutting, Dancing on the Clouds will leave your guests speechless and make your wedding photos unforgettable.</p>
    </div>
  </section>

  <section class="pad bg-deep">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow light">Why it's perfect for your big day</span><h2 class="h-xl">More than a special effect.</h2></div>
      <div class="values" style="grid-template-columns:repeat(2,1fr);">
        {why.map(([t, d], i) => (
          <div class={`value reveal ${i % 2 ? 'd1' : ''}`} style="border-color:rgba(255,255,255,0.14); color:#fff;"><h3>{t}</h3><p style="color:#d9d0ec;">{d}</p></div>
        ))}
      </div>
      <p class="lead reveal" style="max-width:820px; margin:34px auto 0; text-align:center;">When you rent Dancing on the Clouds from Xpress Entertainment, you get the expertise of our team to ensure it’s perfectly executed. We work closely with your venue and other vendors to ensure the cloud effect enhances your moment without disrupting other elements of your day.</p>
    </div>
  </section>

  <CTA eyebrow="Contact us for dancing on the clouds" titleHtml={`Dance on<br>the clouds.`} />
</Base>
