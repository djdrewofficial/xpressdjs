---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import VideoLightbox from '../components/VideoLightbox.astro';

// Curated fallback testimonials — shown only if the live Google pull below
// isn't configured yet or returns nothing.
const curated = [
  { quote: "Xpress Entertainment made our wedding feel like a real party. Drew read the room perfectly and kept the dance floor packed from the first song to the last.", name: 'Sofia & Mateo', event: 'Wedding · Miami', source: 'Google' },
  { quote: 'They handled every transition, every announcement, every little detail so we could just be present. Our guests are still texting us about the music.', name: 'Emma & James', event: 'Wedding · Fort Lauderdale', source: 'Google' },
  { quote: 'Bilingual, professional, and genuinely fun. Our parents from Colombia felt completely included all night. Worth every penny.', name: 'Camila & Daniel', event: 'Wedding · Coral Gables', source: 'Zola' },
  { quote: 'We added cold sparks and dancing on the clouds and it was unreal. The photos came out incredible and the vibe was next-level.', name: 'Ashley & Marcus', event: 'Wedding · Palm Beach', source: 'Google' },
];

// LIVE Google reviews, fetched at BUILD TIME. The API key lives in a
// Cloudflare Pages env var (GOOGLE_PLACES_API_KEY) and is only used here at
// build — it is never shipped to the browser. Set GOOGLE_PLACE_ID too.
// Filters to 5-star, sorts newest first.
let liveReviews = [];
let gRating = null, gTotal = null;
const G_KEY = import.meta.env.GOOGLE_PLACES_API_KEY;
const G_PLACE = import.meta.env.GOOGLE_PLACE_ID;
if (G_KEY && G_PLACE) {
  try {
    const u = `https://maps.googleapis.com/maps/api/place/details/json?place_id=${encodeURIComponent(G_PLACE)}&fields=reviews,rating,user_ratings_total&reviews_sort=newest&language=en&key=${G_KEY}`;
    const res = await fetch(u);
    const data = await res.json();
    if (data && data.result) {
      gRating = data.result.rating;
      gTotal = data.result.user_ratings_total;
      liveReviews = (data.result.reviews || [])
        .filter((r) => r.rating === 5 && r.text && r.text.trim())
        .sort((a, b) => (b.time || 0) - (a.time || 0))
        .slice(0, 6)
        .map((r) => ({
          quote: r.text.trim(),
          name: r.author_name || 'Google reviewer',
          event: (r.relative_time_description || 'Google review') + ' · Google',
          source: 'Google',
        }));
    }
  } catch (e) { /* fall back to curated */ }
}
const reviews = liveReviews.length ? liveReviews : curated;

// Platform hubs. Google's rating/count auto-fill from the live pull when set.
const platforms = [
  { name: 'Google',  short: 'G',  rating: gRating ? gRating.toFixed(1) : '5.0', count: gTotal ? `${gTotal} reviews` : '120+ reviews', url: 'https://g.page/r/xpressdjs/review',                                  accent: '#4285F4' },
  { name: 'Zola',    short: 'Z',  rating: '5.0',                                 count: '40+ reviews',                                  url: 'https://www.zola.com/wedding-vendors/wedding-djs/xpress-entertainment', accent: '#0095CB' },
];

// Wedding vlog highlights (YouTube IDs). Starter set pulled from existing
// content; swap with the wedding vlog videos you actually want to feature.
const vlogs = [
  { id: 'IfiDx2t5OZI', label: 'Vista Lago Ballroom · live wedding' },
  { id: '8jkro4IHl2g', label: 'Packed dance floor highlight' },
  { id: '10994qjwqx8', label: 'Wedding party energy reel' },
  { id: 'vub-gogjGhQ', label: 'First dance + grand entrance' },
];
---
<Base
  title="Reviews | Xpress Entertainment — Real Couples, Real Weddings"
  description="See what couples are saying about Xpress Entertainment on Google and Zola, plus real wedding vlog highlights from across South Florida.">

  <Hero
    size="mid"
    eyebrow="Reviews & Social Proof"
    titleHtml={`The dance floor<br><span class="serif-accent" style="font-style:italic">said it best.</span>`}
    sub="Hundreds of couples have trusted us with their biggest day. Read what they had to say, then watch the parties they're talking about."
    image="/images/heroes/wedding-blog-hero.jpg"
    alt="Wedding guests dancing under string lights"
    creditName="Romina Raggio Photography"
    creditHref="https://rominaraggio.com/"
    ctaText="Check Your Date"
  />

  <!-- HIGHLIGHTED TESTIMONIALS (cross-platform) -->
  <section class="pad bg-ink">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow">From real weddings</span><h2 class="h-xl">What couples are saying.</h2></div>
      <div class="values" style="grid-template-columns:repeat(2,1fr);">
        {reviews.map((r, i) => (
          <div class={`value reveal ${i % 2 ? 'd1' : ''}`} style="border-color:rgba(255,255,255,0.14); color:#fff;">
            <p style="font-family:var(--serif); font-style:italic; font-size:1.15rem; color:#fff; line-height:1.5;">"{r.quote}"</p>
            <p style="margin-top:18px; color:var(--lavender); font-weight:600;">{r.name}</p>
            <p style="color:var(--muted); font-size:0.85rem; letter-spacing:0.04em;">{r.event} · via {r.source}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PLATFORM HUB -->
  <section class="pad bg-deep">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow light">⭐ Verified reviews</span><h2 class="h-xl">Read every review on every platform.</h2><p class="lead">We're proud of every dance floor. See verified couple reviews wherever you trust them most.</p></div>

      <div class="platforms-grid">
        {platforms.map((p, i) => (
          <a href={p.url} target="_blank" rel="noopener noreferrer" class={`platform-card reveal ${['','d1','d2','d3'][i] || ''}`} style={`--platform-accent:${p.accent};`}>
            <span class="platform-mark">{p.short}</span>
            <span class="platform-name">{p.name}</span>
            <span class="platform-stars" aria-label={`${p.rating} stars`}>★★★★★</span>
            <span class="platform-rating">{p.rating} · {p.count}</span>
            <span class="platform-cta">Read on {p.name} <span class="arrow">↗</span></span>

            <!--
              LIVE EMBED SLOT
              Google -> no free native embed; use a widget (Trustindex /
                        Elfsight free tier) or the Places API, then paste here.
              Zola   -> Pro dashboard -> "Reviews badge" -> copy code here.
            -->
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WEDDING VLOG -->
  <section class="pad bg-ink">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow">Wedding Vlog</span><h2 class="h-xl">Press play. See the party.</h2><p class="lead">Real weddings, real dance floors, real moments. The kind of nights couples book us hoping to throw.</p></div>
      <div class="vlog-grid">
        {vlogs.map((v, i) => (
          <VideoLightbox compact id={v.id} label={v.label} class={['','d1','d2','d3'][i] || ''} />
        ))}
      </div>
    </div>
  </section>

  <!-- LEAVE A REVIEW NUDGE -->
  <section class="pad bg-deep">
    <div class="wrap" style="max-width:720px; text-align:center;">
      <div class="reveal">
        <span class="eyebrow light">Recently worked with us?</span>
        <h2 class="h-lg" style="margin:14px 0 16px;">Leave us a review.</h2>
        <p class="lead">If we helped make your day unforgettable, a quick review on Google or Zola goes a long way. Thank you 💛</p>
        <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-top:28px;">
          {platforms.map((p) => (
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="btn ghost"><span>{p.name}</span> <span class="arrow">↗</span></a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTA eyebrow="💌 Ready to be the next happy couple?" titleHtml={`Let's pack<br>your dance floor.`} text="Check our availability for your date and start planning the party your guests will remember." />
</Base>

<style>
  /* Platform hub */
  .platforms-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin: 28px auto 0;
    max-width: 640px;
  }
  @media (max-width: 480px) { .platforms-grid { grid-template-columns: 1fr; } }

  .platform-card {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: 8px; padding: 28px 22px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    color: #fff; text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    position: relative; overflow: hidden;
  }
  .platform-card::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse at top, var(--platform-accent, #fff) 0%, transparent 60%);
    opacity: 0.10; transition: opacity 0.25s ease;
  }
  .platform-card:hover { transform: translateY(-3px); background: rgba(255,255,255,0.07); border-color: rgba(255,255,255,0.22); }
  .platform-card:hover::before { opacity: 0.18; }

  .platform-mark {
    width: 52px; height: 52px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--platform-accent, #fff); color: #fff;
    font-family: var(--serif); font-weight: 700; font-size: 1.3rem;
    box-shadow: 0 10px 24px rgba(0,0,0,0.35);
    margin-bottom: 6px;
  }
  .platform-name { font-family: var(--serif); font-size: 1.5rem; font-weight: 600; }
  .platform-stars { color: #ffd166; letter-spacing: 0.1em; font-size: 1.05rem; }
  .platform-rating { color: var(--lavender); font-size: 0.85rem; letter-spacing: 0.05em; }
  .platform-cta { margin-top: 8px; font-size: 0.92rem; color: #fff; opacity: 0.92; }
  .platform-cta .arrow { display: inline-block; margin-left: 4px; transition: transform 0.2s; }
  .platform-card:hover .platform-cta .arrow { transform: translate(3px, -3px); }

  /* Vlog grid */
  .vlog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-top: 28px;
  }
  @media (max-width: 640px) { .vlog-grid { grid-template-columns: 1fr; } }
</style>
