---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import Ph from '../components/Ph.astro';
import FaqSchema from '../components/FaqSchema.astro';
import { phUri } from '../lib/ph';

// How it works — 4 steps.
const steps = [
  ['01 · Snap', 'Guests step up to your wedding photo booth and take their pictures, same as always.'],
  ['02 · Visit the station', 'They walk over to the staffed Keychain Station and choose their strap color.'],
  ['03 · Built on the spot', 'Our attendant sets their photo into a leather keychain with gold hardware while they watch.'],
  ['04 · Theirs to keep', 'They leave with a finished keepsake that goes on their keys, not in a drawer.'],
];

// What's included.
const included = [
  'A dedicated Keychain Station attendant',
  'Display and assembly table setup',
  'Leather-style straps with gold hardware',
  'Your custom circular photo insert',
  'Live assembly throughout your reception',
  'On-site strap-color choice for every guest',
];

// Who it's perfect for.
const perfectFor = [
  'Weddings that already have a photo booth',
  'Couples who want an interactive favor',
  'Guests who love a personalized keepsake',
  'Luxury and multicultural weddings',
  'High-energy South Florida receptions',
  'Anyone done with the standard favor',
];

const faqs = [
  { q: 'How many keychains should we order?', a: 'We recommend matching your guest count. If you have 100 guests, order 100 keychains so no one misses out.' },
  { q: 'Can guests choose their strap color?', a: 'Yes. Guests pick from the available strap colors right at the station during your event.' },
  { q: 'Do guests choose the design inside the keychain?', a: 'The couple chooses the insert style before the wedding. You can go with two photos, or one photo plus your wedding monogram/design.' },
  { q: 'Is this included with the photo booth?', a: "It's a premium upgrade you add to your photo booth package, so the booth and the Keychain Station run together as one experience." },
  { q: 'What does pricing start at?', a: 'Keychain Station pricing starts at $795.' },
  { q: 'Is this available for every wedding?', a: 'Availability can be limited. The keychain components are hard to source and sometimes sell out, so reserve early to lock in your date.' },
];
const faqItems = faqs.map((f) => ({ q: f.q, a: f.a }));
---
<Base
  title="Keychain Photo Booth Station for Weddings | Xpress Entertainment"
  description="Upgrade your wedding photo booth with Xpress Entertainment's Keychain Station — a live custom wedding favor experience with leather keychains, gold hardware, and personalized photo inserts.">

  <div class="kc-page">
    <!-- TODO(image): replace hero with a wide, premium shot of the Keychain
         Station or a hero macro of a finished leather + gold keychain (2560x1440). -->
    <Hero
      size="tall"
      eyebrow="Wedding Photo Booth Upgrade"
      titleHtml={`The photo booth favor your guests <span class="serif-accent" style="font-style:italic">actually keep.</span>`}
      sub="At our Keychain Station, guests turn their photo booth pictures into custom leather keychains with gold hardware, assembled live at your wedding. It's the South Florida wedding favor people put on their keys instead of in a drawer."
      image={phUri(2560, 1440, 'Keychain Station — hero', 'Wide shot of the staffed station or a macro of a finished keychain')}
      alt="Xpress Entertainment Keychain Station at a South Florida wedding"
      ctaText="Check Availability"
      ctaText2="View Photo Booth Options"
      ctaHref2="/south-florida-photo-booth-rental"
    />

    <!-- INTRO -->
    <section class="pad bg-ink">
      <div class="wrap" style="max-width:880px;">
        <p class="lead reveal" style="text-align:center;">Here's the thing about wedding favors: most of them get left on the table. You pay for them, and by the end of the night they're forgotten. The Keychain Station works differently. Guests grab their photo booth print, pick a strap color, and watch our attendant build their keychain on the spot.</p>
        <p class="lead reveal d1" style="text-align:center; margin-top:18px;">They walk out with something they'll actually carry, and you get a favor that doubles as entertainment. It's made to pair with our <a href="/south-florida-photo-booth-rental" class="textlink">South Florida wedding photo booths</a> for couples across Miami, Fort Lauderdale, and Palm Beach.</p>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="pad bg-deep">
      <div class="wrap">
        <div class="sec-head center reveal"><span class="eyebrow light">How it works</span><h2 class="h-xl">A favor that happens live.</h2></div>
        <div class="values" style="grid-template-columns:repeat(4,1fr);">
          {steps.map(([t, d], i) => (
            <div class={`value reveal ${['', 'd1', 'd2', 'd3'][i]}`} style="border-color:rgba(255,255,255,0.14); color:#fff;">
              <h3 style="font-family:var(--serif); font-size:1.4rem;">{t}</h3>
              <p style="color:#d9d0ec; margin-top:10px;">{d}</p>
            </div>
          ))}
        </div>
        <p class="lead reveal" style="text-align:center; margin-top:30px; color:var(--lavender); max-width:760px; margin-inline:auto;">Before the wedding, you pick the insert: <strong>two photos</strong> in each keychain, or <strong>one photo paired with your wedding monogram</strong>.</p>
      </div>
    </section>

    <!-- WHAT'S INCLUDED -->
    <section class="pad bg-ink">
      <div class="wrap">
        <div class="sec-head center reveal"><span class="eyebrow">What's included</span><h2 class="h-xl">Fully staffed, fully handled.</h2></div>
        <div class="reveal" style="max-width:680px; margin:0 auto;">
          {included.map((name) => (
            <div style="display:flex; align-items:center; gap:16px; padding:18px 0; border-bottom:1px solid rgba(255,255,255,0.12);">
              <span style="color:var(--red); font-family:var(--serif); font-size:1.2rem;">✦</span><span style="font-size:1.15rem;">{name}</span>
            </div>
          ))}
        </div>
        <div class="reveal" style="text-align:center; margin-top:36px;">
          <div style="font-family:var(--serif); font-size:2.6rem; color:var(--red); line-height:1;">Starts at $795</div>
          <p style="color:var(--muted); margin-top:12px;">Added on to your photo booth package.</p>
          <div style="margin-top:24px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
            <a href="/check-availability" class="btn"><span>Check Availability</span> <span class="arrow">↗</span></a>
            <a href="/south-florida-photo-booth-rental" class="btn ghost"><span>View Photo Booth Options</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- WHO IT'S PERFECT FOR -->
    <section class="pad bg-deep">
      <div class="wrap" style="max-width:920px;">
        <div class="sec-head center reveal"><span class="eyebrow light">Who it's perfect for</span><h2 class="h-xl">Made for couples who sweat the details.</h2></div>
        <ul class="kc-tags reveal">
          {perfectFor.map((o) => <li>{o}</li>)}
        </ul>
      </div>
    </section>

    <!-- GALLERY -->
    <section class="pad bg-ink">
      <div class="wrap">
        <div class="sec-head reveal"><span class="eyebrow">The look</span><h2 class="h-xl">Leather, gold, and your photos.</h2></div>
        <div class="kc-gallery">
          <!-- TODO(image): real macro close-up of a finished leather + gold keychain -->
          <figure class="reveal"><Ph w={1000} h={1000} label="Keychain close-up" note="Macro of a finished leather + gold keychain" /></figure>
          <!-- TODO(image): guest smiling as they receive their keychain at the station -->
          <figure class="reveal d1"><Ph w={1000} h={1000} label="Guest receiving keychain" note="Guest receiving their keychain at the station" /></figure>
          <!-- TODO(image): the staffed Keychain Station display + setup table -->
          <figure class="reveal d2"><Ph w={1000} h={1000} label="Keychain Station setup" note="Staffed display + setup table at the reception" /></figure>
          <!-- TODO(image): a photo booth print / sample insert photo -->
          <figure class="reveal"><Ph w={1000} h={1000} label="Photo booth print" note="Sample photo booth print used for the insert" /></figure>
          <!-- TODO(image): the available leather strap color options, laid out -->
          <figure class="reveal d1"><Ph w={1000} h={1000} label="Strap color options" note="Flat-lay of the available leather strap colors" /></figure>
          <!-- TODO(image): a finished keychain showing the wedding monogram insert -->
          <figure class="reveal d2"><Ph w={1000} h={1000} label="Monogram insert" note="Keychain with the couple's wedding monogram insert" /></figure>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="pad bg-deep">
      <div class="wrap" style="max-width:880px;">
        <div class="sec-head center reveal"><span class="eyebrow light">Good to know</span><h2 class="h-xl">Keychain Station FAQs.</h2></div>
        <div style="display:flex; flex-direction:column; gap:18px;">
          {faqs.map((f, i) => (
            <div class={`value reveal ${i % 2 ? 'd1' : ''}`} style="border-color:rgba(255,255,255,0.14); color:#fff;">
              <h3 style="font-size:1.15rem;">{f.q}</h3>
              <p style="color:#d9d0ec; margin-top:8px;">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <FaqSchema items={faqItems} />

    <CTA eyebrow="💛 The favor they keep" titleHtml={`Give your guests a favor<br>they'll actually keep.`} text="Ask about adding the Keychain Station to your South Florida wedding photo booth." ctaText="Ask About the Keychain Station" />
  </div>
</Base>

<style>
  /* This page's headlines (hero + final CTA both use .display) run long, so
     dial the display size down here without touching the rest of the site. */
  .kc-page :global(.display) { font-size: clamp(2.1rem, 5vw, 4.2rem); }

  .kc-tags {
    list-style: none; padding: 0; margin: 28px 0 0;
    display: flex; flex-wrap: wrap; gap: 10px; justify-content: center;
  }
  .kc-tags li {
    padding: 10px 18px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.18);
    color: #fff; font-size: 0.95rem; letter-spacing: 0.02em;
    background: rgba(255,255,255,0.04);
  }

  .kc-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 28px; }
  .kc-gallery figure { margin: 0; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 14px; background: #0a0612; }
  .kc-gallery img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.7s var(--ease); }
  .kc-gallery figure:hover img { transform: scale(1.04); }
  @media (max-width: 760px) { .kc-gallery { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .kc-gallery { grid-template-columns: 1fr; } }
</style>
