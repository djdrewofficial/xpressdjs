---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import Credit from '../components/Credit.astro';
import FaqSchema from '../components/FaqSchema.astro';

const why = [
  ['🏳️‍🌈 All Are Welcome Here', "We’re not just okay with it. We’re genuinely happy to be there. Every couple and every guest is welcome at our events, and that’s been true since day one. If you want an inclusive wedding DJ in Miami or anywhere nearby, you’ve found one."],
  ['🎶 Your Story, Your Soundtrack', "We don’t run a set playlist or a set script. We never assume who’s walking down the aisle or who’s leading the first dance. You tell us how you want the night to go, and we make it happen."],
  ['🎤 Bilingual DJs & MCs', "We host in English and Spanish, so everyone in the room feels included, from your college friends up front to abuela in the back."],
  ['✨ We Handle the Details', "We take care of the announcements, the timing, and all the little cues that keep a wedding moving. That way you can actually be present for your day instead of running it."],
];

const areas = [
  ['Miami', "We’re an LGBTQ wedding DJ in Miami, and we’ve thrown parties for gay, lesbian, and same-sex couples all over Miami-Dade. If you want an inclusive wedding DJ in Miami who actually gets your vision, that’s us."],
  ['Fort Lauderdale & Broward', "Whether you need a gay wedding DJ in Fort Lauderdale or a gay wedding DJ in Broward County, we cover the whole area, from beachfront ceremonies to ballroom receptions."],
  ['West Palm Beach & Palm Beach County', "From Palm Beach down to Boca, we’re an LGBTQ-friendly wedding DJ in West Palm Beach and a go-to LGBTQ wedding DJ in Palm Beach County."],
  ['All of South Florida', "Getting married somewhere else in the area? We’re a same-sex wedding DJ in South Florida too. We show up early, read the room, and keep people dancing."],
];

const faqs = [
  { q: 'Do you DJ gay and same-sex weddings in South Florida?', a: "Yes, and we love it. We’re a same-sex wedding DJ in South Florida, and we’ve worked with plenty of gay, lesbian, and LGBTQ couples in Miami, Fort Lauderdale, West Palm Beach, and everywhere in between." },
  { q: 'Are you an LGBTQ-friendly wedding DJ in Miami and Fort Lauderdale?', a: "We are. We’re an inclusive wedding DJ in Miami and a gay wedding DJ in Fort Lauderdale, and we treat every couple the same way: with respect, real excitement, and zero weirdness." },
  { q: 'Do you serve LGBTQ couples in West Palm Beach and Palm Beach County?', a: "Yes. We’re an LGBTQ-friendly wedding DJ in West Palm Beach and an LGBTQ wedding DJ in Palm Beach County, and we travel all over the area for the right celebration." },
  { q: 'How do you handle traditions and the order of events for same-sex weddings?', a: "However you want. We never assume who walks down the aisle, who gets introduced first, or who leads the first dance. We plan the whole timeline around the two of you, and we keep the language inclusive all night." },
  { q: 'Can you MC in both English and Spanish?', a: "Yes. Our DJs and MCs are bilingual, so nobody in the room feels left out. It’s one of the big reasons couples around South Florida book us." },
];
const faqItems = faqs.map((f) => ({ q: f.q, a: f.a }));
---
<Base
  title="LGBTQ Wedding DJ in South Florida | Gay & Same-Sex Wedding DJs — Xpress Entertainment"
  description="Inclusive LGBTQ wedding DJs serving Miami, Fort Lauderdale, West Palm Beach and all of South Florida. Xpress Entertainment celebrates gay and same-sex weddings with personalized, high-energy entertainment.">

  <Hero
    eyebrow="LGBTQ Wedding DJ · South Florida"
    titleHtml={`Love is love.<br><span class="serif-accent" style="font-style:italic">Let’s celebrate it.</span>`}
    sub="We’re a wedding DJ company that celebrates every couple, all over South Florida. If you’re getting married in Miami, Fort Lauderdale, or West Palm Beach, we’d love to be the reason your dance floor stays full all night."
    image="/images/lgbtq-first-dance-clouds-cold-sparks.jpg"
    alt="LGBTQ+ newlyweds celebrating their first dance on the clouds and with cold spark machines"
    creditName="Amarena Productions"
    creditHref="https://amarenaproductions.com/"
    ctaText="Check Your Date"
  />

  <section class="pad bg-ink">
    <div class="wrap" style="max-width:880px;">
      <p class="lead reveal">We’ve spent years DJing weddings all over South Florida, and a lot of them have been for gay, lesbian, and same-sex couples. Your wedding should feel like the two of you, not like a template someone handed you. So that’s how we do it. You tell us what matters, and we build the night around it.</p>
    </div>
  </section>

  <!-- WHY -->
  <section class="pad bg-deep">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow light">🏳️‍🌈 Why LGBTQ couples book Xpress Entertainment</span><h2 class="h-xl">Celebrated, never tolerated.</h2></div>
      <div class="values" style="grid-template-columns:repeat(2,1fr);">
        {why.map(([t, d], i) => (
          <div class={`value reveal ${i % 2 ? 'd1' : ''}`} style="border-color:rgba(255,255,255,0.14); color:#fff;"><h3>{t}</h3><p style="color:#d9d0ec;">{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- INCLUSIVE SPLIT -->
  <section class="pad bg-ink">
    <div class="wrap">
      <div class="split">
        <figure class="reveal" style="margin:0;">
          <div class="media"><img src="/images/lesbian-couple-first-dance.jpg" alt="Lesbian couple sharing their first dance during their wedding" /></div>
          <Credit variant="caption" name="La Vie Studios" href="http://www.laviestudios.com/" />
        </figure>
        <div class="reveal d1">
          <span class="eyebrow">A wedding that feels like you</span>
          <h2 class="h-lg" style="margin:14px 0 16px;">Your day, your way.</h2>
          <p class="lead">None of this is one-size-fits-all. We sit down with you and figure out the details together: how you want to be introduced, when you want to dance, the songs that actually mean something to you. We don’t assume any of it.</p>
          <p class="lead" style="margin-top:14px;">Want a loud, sweaty dance party? Great. Prefer something more low-key and elegant? Also great. We read the room and keep things going at whatever energy fits you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICE AREAS (geo SEO) -->
  <section class="pad bg-light">
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow">Where we celebrate</span><h2 class="h-xl">Serving LGBTQ couples across South Florida.</h2><p class="lead">Wherever your celebration happens, we’ll be there early, ready to throw a party your friends talk about for years.</p></div>
      <div class="values" style="grid-template-columns:repeat(2,1fr);">
        {areas.map(([t, d], i) => (
          <div class={`value reveal ${i % 2 ? 'd1' : ''}`}><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- GALLERY SPLIT -->
  <section class="pad bg-ink">
    <div class="wrap">
      <div class="split">
        <figure class="reveal" style="margin:0;">
          <div class="media"><img src="/images/gay-couple-dance-floor.jpg" alt="Gay couple enjoying their wedding on the dance floor" /></div>
          <Credit variant="caption" name="Amarena Productions" href="https://amarenaproductions.com/" />
        </figure>
        <div class="reveal d1">
          <span class="eyebrow">Bilingual · Inclusive · A whole lot of fun</span>
          <h2 class="h-lg" style="margin:14px 0 16px;">Everyone on the dance floor.</h2>
          <p class="lead">Our DJs and MCs work in both English and Spanish, and we keep the language welcoming all night so every guest feels included. It’s a big reason couples in Miami, Fort Lauderdale, and Palm Beach County pick us as their inclusive wedding DJ.</p>
          <p class="lead" style="margin-top:14px;">And yes, all are welcome here. Always.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="pad bg-deep">
    <div class="wrap" style="max-width:880px;">
      <div class="sec-head center reveal"><span class="eyebrow light">Good to know</span><h2 class="h-xl">LGBTQ wedding DJ FAQs.</h2></div>
      <div style="display:flex; flex-direction:column; gap:18px;">
        {faqs.map((f, i) => (
          <div class={`value reveal ${i % 2 ? 'd1' : ''}`} style="border-color:rgba(255,255,255,0.14); color:#fff;">
            <h3 style="font-size:1.2rem;">{f.q}</h3>
            <p style="color:#d9d0ec; margin-top:10px;">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <FaqSchema items={faqItems} />

  <CTA eyebrow="🏳️‍🌈 Ready to celebrate your love story?" titleHtml={`Love is love.<br>Let’s throw a party.`} text="Tell us about your day. We can’t wait to be part of it." />
</Base>
