---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import Ph from '../components/Ph.astro';
import FaqSchema from '../components/FaqSchema.astro';
import { phUri } from '../lib/ph';

const why = [
  ['🏳️‍🌈 All Are Welcome Here', "We don’t just tolerate — we celebrate. Every couple, every love story, and every guest is welcome on our dance floor. As an inclusive wedding DJ in Miami and across South Florida, your celebration is exactly that: yours."],
  ['🎶 Your Story, Your Soundtrack', "No cookie-cutter playlists and no gendered scripts. We never assume who walks down the aisle or who shares the first dance — every moment is built around the two of you."],
  ['🎤 Bilingual DJs & MCs', "We host in both English and Spanish with warm, inclusive language, so every guest — from your closest friends to abuela — feels part of the celebration."],
  ['✨ Seamless, Stress-Free Flow', "From ceremony cues to the final song, we handle transitions, announcements, and timing so you can stay fully present and just enjoy your day."],
];

const areas = [
  ['Miami', "As an LGBTQ wedding DJ in Miami, we bring high-energy, personalized entertainment to gay, lesbian, and same-sex celebrations across Miami-Dade — you can also count on us as your inclusive wedding DJ in Miami."],
  ['Fort Lauderdale & Broward', "Looking for a gay wedding DJ in Fort Lauderdale or a gay wedding DJ in Broward County? We proudly DJ LGBTQ weddings throughout Broward, from beachfront ceremonies to ballroom receptions."],
  ['West Palm Beach & Palm Beach County', "We’re an LGBTQ-friendly wedding DJ in West Palm Beach and a trusted LGBTQ wedding DJ in Palm Beach County — celebrating love stories from Palm Beach to Boca Raton."],
  ['All of South Florida', "From the Keys to the Treasure Coast, we’re a same-sex wedding DJ in South Florida who shows up early, reads the room, and keeps the dance floor packed all night."],
];

const faqs = [
  { q: 'Do you DJ gay and same-sex weddings in South Florida?', a: "Absolutely — and proudly. Xpress Entertainment is a same-sex wedding DJ in South Florida with experience celebrating gay, lesbian, and LGBTQ couples across Miami, Fort Lauderdale, West Palm Beach, and beyond. Your love story is always welcome here." },
  { q: 'Are you an LGBTQ-friendly wedding DJ in Miami and Fort Lauderdale?', a: "Yes. We’re an inclusive wedding DJ in Miami and a gay wedding DJ in Fort Lauderdale who treats every couple with the respect, warmth, and excitement they deserve. No assumptions, no awkwardness — just a celebration that feels like you." },
  { q: 'Do you serve LGBTQ couples in West Palm Beach and Palm Beach County?', a: "We do. As an LGBTQ-friendly wedding DJ in West Palm Beach and an LGBTQ wedding DJ in Palm Beach County, we travel throughout the area to make sure your wedding is unforgettable." },
  { q: 'How do you handle traditions and the order of events for same-sex weddings?', a: "Every part of your day is fully customizable. We never assume who walks down the aisle, who is introduced first, or who shares the first dance — we build the timeline around your vision, with inclusive language throughout." },
  { q: 'Can you MC in both English and Spanish?', a: "Yes — our DJs and MCs are bilingual, so every guest feels included no matter their background. It’s a big reason couples across South Florida choose us as their inclusive wedding DJ." },
];
const faqItems = faqs.map((f) => ({ q: f.q, a: f.a }));
---
<Base
  title="LGBTQ Wedding DJ in South Florida | Gay & Same-Sex Wedding DJs — Xpress Entertainment"
  description="Proudly inclusive LGBTQ wedding DJs serving Miami, Fort Lauderdale, West Palm Beach & all of South Florida. Xpress Entertainment celebrates gay and same-sex weddings with high-energy, personalized entertainment.">

  <Hero
    eyebrow="LGBTQ Wedding DJ · South Florida"
    titleHtml={`Love is love.<br><span class="serif-accent" style="font-style:italic">Let’s celebrate it.</span>`}
    sub="From Miami to Fort Lauderdale to West Palm Beach, Xpress Entertainment is a proudly inclusive wedding DJ company that celebrates every couple. Whatever your love story, we’ll make your dance floor unforgettable."
    image={phUri(2560, 1440, 'LGBTQ wedding celebration — hero', 'Two grooms / two brides celebrating on a packed dance floor')}
    alt="LGBTQ wedding DJ in South Florida — two grooms celebrating on the dance floor"
    ctaText="Check Your Date"
  />

  <section class="pad bg-ink">
    <div class="wrap" style="max-width:880px;">
      <p class="lead reveal">At Xpress Entertainment, every love story deserves a celebration as unique as the couple living it. As an experienced LGBTQ wedding DJ across South Florida, we’ve helped gay, lesbian, and same-sex couples throw weddings that are joyful, personal, and packed with dancing from the first song to the last. No assumptions, no scripts — just your celebration, your way.</p>
    </div>
  </section>

  <!-- WHY -->
  <section class="pad bg-deep">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow light">🏳️‍🌈 Why LGBTQ couples book Xpress Entertainment</span><h2 class="h-xl">Celebrated, never tolerated.</h2></div>
      <div class="values" style="grid-template-columns:repeat(2,1fr);">
        {why.map(([t, d], i) => (
          <div class={`value reveal ${i % 2 ? 'd1' : ''}`} style="border-color:rgba(255,255,255,0.14); color:#fff;"><h3>{t}</h3><p style="color:#d9d0ec;">{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- INCLUSIVE SPLIT -->
  <section class="pad bg-ink">
    <div class="wrap">
      <div class="split">
        <div class="media reveal"><Ph w={1200} h={900} label="Same-sex couple first dance" note="Two grooms or two brides sharing a first dance" /></div>
        <div class="reveal d1">
          <span class="eyebrow">A wedding that feels like you</span>
          <h2 class="h-lg" style="margin:14px 0 16px;">Your day, your way.</h2>
          <p class="lead">From the grand entrance to the last dance, nothing about your wedding is one-size-fits-all. We work with you to design every moment — who’s announced, when you dance, the songs that tell your story — with zero assumptions and zero gendered scripts.</p>
          <p class="lead" style="margin-top:14px;">Whether you want a high-energy party, an elegant evening, or a little of both, we read the room and keep the love (and the dance floor) going all night long.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICE AREAS (geo SEO) -->
  <section class="pad bg-light">
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow">Where we celebrate</span><h2 class="h-xl">Serving LGBTQ couples across South Florida.</h2><p class="lead">Wherever your celebration takes place, we’ll be there — early, polished, and ready to throw an unforgettable party.</p></div>
      <div class="values" style="grid-template-columns:repeat(2,1fr);">
        {areas.map(([t, d], i) => (
          <div class={`value reveal ${i % 2 ? 'd1' : ''}`}><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- GALLERY SPLIT -->
  <section class="pad bg-ink">
    <div class="wrap">
      <div class="split">
        <div class="media reveal"><Ph w={1200} h={900} label="LGBTQ wedding dance floor" note="Packed, joyful dance floor at an LGBTQ wedding" /></div>
        <div class="reveal d1">
          <span class="eyebrow">Bilingual · Inclusive · Unforgettable</span>
          <h2 class="h-lg" style="margin:14px 0 16px;">Everyone on the dance floor.</h2>
          <p class="lead">Our bilingual DJs and MCs host in English and Spanish with warm, inclusive language, so every guest feels part of the celebration. It’s a big reason couples across Miami, Fort Lauderdale, and Palm Beach County choose us as their inclusive wedding DJ.</p>
          <p class="lead" style="margin-top:14px;">And yes — <strong>all are welcome here.</strong> Always.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="pad bg-deep">
    <div class="wrap" style="max-width:880px;">
      <div class="sec-head center reveal"><span class="eyebrow light">Good to know</span><h2 class="h-xl">LGBTQ wedding DJ FAQs.</h2></div>
      <div style="display:flex; flex-direction:column; gap:18px;">
        {faqs.map((f, i) => (
          <div class={`value reveal ${i % 2 ? 'd1' : ''}`} style="border-color:rgba(255,255,255,0.14); color:#fff;">
            <h3 style="font-size:1.2rem;">{f.q}</h3>
            <p style="color:#d9d0ec; margin-top:10px;">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <FaqSchema items={faqItems} />

  <CTA eyebrow="🏳️‍🌈 Ready to celebrate your love story?" titleHtml={`Love is love.<br>Let’s throw a party.`} text="Tell us about your day — we can’t wait to be part of it." />
</Base>
