---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
---
<Base title="Careers | Xpress Entertainment — Work With Us" description="Get paid to have fun. Xpress Entertainment is a crew of independent DJs and artists creating extraordinary South Florida weddings. Join the team.">

  <Hero
    size="mid"
    eyebrow="Work with us"
    titleHtml={`Get paid to<br>have fun.`}
    sub="Xpress Entertainment is a group of independent DJs and artists who came together to create something special — the most extravagant experiences for our couples. If that sounds like you, we'd love to meet."
    image="https://xpressdjs.com/wp-content/uploads/2025/04/xpress-djs-entertainment-party-wedding.png"
    alt="DJ performing"
    ctaText="Apply Now"
    ctaHref="/check-availability"
  />

  <section class="pad bg-ink">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow">Who we're looking for</span><h2 class="h-xl">Performers, not button-pushers.</h2></div>
      <div class="values">
        <div class="value reveal" style="border-color:rgba(255,255,255,0.14); color:#fff;"><div class="vnum">01</div><h3>DJs & MCs</h3><p style="color:#d9d0ec;">Open-format talent who can read a room, host with confidence, and ideally spin bilingual sets.</p></div>
        <div class="value reveal d1" style="border-color:rgba(255,255,255,0.14); color:#fff;"><div class="vnum">02</div><h3>Content Creators</h3><p style="color:#d9d0ec;">Shooters who can capture and cut social-ready Reels in real time at live events.</p></div>
        <div class="value reveal d2" style="border-color:rgba(255,255,255,0.14); color:#fff;"><div class="vnum">03</div><h3>Booth Attendants</h3><p style="color:#d9d0ec;">Friendly, reliable pros who keep the photo & 360 booths buzzing all night.</p></div>
      </div>
    </div>
  </section>

  <CTA eyebrow="Join the crew" titleHtml={`Let's make<br>magic together.`} text="Tell us who you are and what you do — we'll be in touch." ctaText="Apply Now" />
</Base>
