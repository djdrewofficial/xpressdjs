---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
---
<Base title="Careers | Xpress Entertainment — Work With Us" description="Get paid to have fun. Xpress Entertainment is a group of independent DJs and artists who curate the most extravagant Xperiences for our clients. Work with us.">

  <Hero
    size="mid"
    eyebrow="Work with us"
    titleHtml={`Get paid to<br>have fun.`}
    sub="Xpress Entertainment is a group of independent DJs and artists that have come together to form something special. We curate the most extravagant Xperiences for our clients and love every moment of it. If this sounds like you, we’d love to meet you."
    image="https://xpressdjs.com/wp-content/uploads/2023/06/Hollie-Brittany-Wedding-by-Sara-Boyd-Photography-946-1024x683.jpg"
    alt="Xpress Entertainment team"
    ctaText="Apply Now"
    ctaHref="/check-availability"
  />

  <CTA eyebrow="Join the crew" titleHtml={`Work with us.`} text="Tell us who you are and what you do — we'd love to meet you." ctaText="Get In Touch" />
</Base>
