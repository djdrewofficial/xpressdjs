---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LangToggle from '../components/LangToggle.astro';
import { getLocale, toEnPath, hasES } from '../i18n/ui';

const {
  title,
  description,
  image = '/images/og-default.png',
  noindex = false,
  // A2P/SMS compliance: the GoHighLevel chat widget collects phone numbers &
  // SMS opt-in, so it must NOT appear on pages that already have a form
  // collecting phone numbers or SMS consent (lead, contact, or appointment
  // forms). Those pages set hideChat to suppress the widget.
  hideChat = false,
  // Inquiry pages keep name, email, and phone in the DOM. Session replay stays off there
  // even after analytics is allowed.
  noReplay = false,
} = Astro.props;

const locale = getLocale(Astro.url);
const enPath = toEnPath(Astro.url.pathname);
// Social scrapers need an absolute URL. Resolve relative paths against the
// site domain; pass-through any already-absolute URL.
const ogImage = image.startsWith('http') ? image : new URL(image, Astro.site ?? Astro.url).href;

// Site-wide LocalBusiness structured data (helps Google's local pack,
// knowledge panel, and rich results). Renders invisibly in <head>.
const SITE_ORIGIN = Astro.site ? Astro.site.origin : 'https://xpressdjs.com';
const altEn = SITE_ORIGIN + enPath;
const altEs = SITE_ORIGIN + (enPath === '/' ? '/es/' : '/es' + enPath);

// Analytics IDs are public client-side values. They are not loaded until the
// visitor allows analytics. Either ID can be overridden with PUBLIC_GA4_ID
// or PUBLIC_CLARITY_ID.
//   PUBLIC_GA4_ID      = G-XXXXXXXXXX   (Google Analytics 4 Measurement ID)
//   PUBLIC_CLARITY_ID  = xxxxxxxxxx     (Microsoft Clarity project ID)
const GA4_ID = import.meta.env.PUBLIC_GA4_ID || 'G-GFTVJ190J0';
const CLARITY_ID = import.meta.env.PUBLIC_CLARITY_ID || 'y4xq7tf2or';
const consentCopy = locale === 'es'
  ? {
      bannerTitle: 'Cookies del sitio',
      bannerBody: 'Usamos cookies de analítica, grabación de sesiones y chat para entender las visitas y ayudarte. Elige Aceptar para permitirlas, Personalizar o Rechazar.',
      accept: 'Aceptar',
      reject: 'Rechazar',
      customize: 'Personalizar',
      privacy: 'Política de privacidad',
      dialogTitle: 'Personalizar cookies',
      dialogBody: 'Estas casillas siguen sin marcar hasta que guardas una elección. Aceptar en la barra permite juntas la analítica, la grabación de sesiones y el chat. El formulario de consulta no carga la grabación ni el chat.',
      analyticsLabel: 'Analítica',
      analyticsHint: 'Carga Google Analytics 4 y PromptWatch.',
      replayLabel: 'Grabación de sesiones',
      replayHint: 'Carga Microsoft Clarity. En el formulario de consulta no se carga, aunque la permitas en otras páginas.',
      chatLabel: 'Chat de LeadConnector',
      chatHint: 'Carga el chat, que puede guardar cookies y pedir un teléfono. El formulario de consulta no lo carga.',
      save: 'Guardar',
      close: 'Cerrar',
      chatButton: 'Chat',
      chatAria: 'Revisar el chat antes de cargarlo',
    }
  : {
      bannerTitle: 'Site cookies',
      bannerBody: 'We use analytics, session replay, and chat cookies to understand visits and help you. Choose Agree to allow them, Customize, or Decline.',
      accept: 'Agree',
      reject: 'Decline',
      customize: 'Customize',
      privacy: 'Privacy policy',
      dialogTitle: 'Customize cookies',
      dialogBody: 'These boxes stay unchecked until you save a choice. Agree on the bar allows analytics, session replay, and chat together. The inquiry form does not load session replay or chat.',
      analyticsLabel: 'Analytics',
      analyticsHint: 'Loads Google Analytics 4 and PromptWatch.',
      replayLabel: 'Session replay',
      replayHint: 'Loads Microsoft Clarity. The inquiry form does not load it, even when it is allowed on other pages.',
      chatLabel: 'LeadConnector chat',
      chatHint: 'Loads chat, which can set cookies and ask for a phone number. The inquiry form does not load it.',
      save: 'Save choices',
      close: 'Close',
      chatButton: 'Chat',
      chatAria: 'Review chat before it loads',
    };
const consentBoot = {
  ga4: GA4_ID,
  clarity: CLARITY_ID,
  promptwatch: '2ef09549-34fc-4564-9593-a86e232989cc',
  widgetId: '6a4c5594af4e62471842d114',
  chat: !hideChat,
  replay: !noReplay,
  privacyHref: locale === 'es' ? '/es/privacy-policy' : '/privacy-policy',
  strings: consentCopy,
};
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'EntertainmentBusiness',
  '@id': `${SITE_ORIGIN}/#business`,
  name: 'Xpress Entertainment',
  legalName: 'Xpress Entertainment Corp.',
  alternateName: 'Xpress DJs',
  description: 'Wedding DJ, MC and event production company serving Miami, Fort Lauderdale and Palm Beach since 2016, with a bilingual MC in English and Spanish.',
  url: `${SITE_ORIGIN}/`,
  telephone: '+1-954-833-1196',
  email: 'events@xpressdjs.com',
  logo: `${SITE_ORIGIN}/logo.svg`,
  image: `${SITE_ORIGIN}/images/og-default.png`,
  foundingDate: '2016',
  founder: [
    {
      '@type': 'Person',
      name: 'Drew Segura',
      url: `${SITE_ORIGIN}/dj-drew-segura`,
      jobTitle: 'Co-owner, DJ and MC',
      knowsLanguage: ['en', 'es'],
      sameAs: [
        'https://djdrewofficial.com/',
        'https://instagram.com/djdrewofficial',
        'https://youtube.com/@djdrewofficial',
        'https://soundcloud.com/djdrewofficial',
        'https://mixcloud.com/djdrewofficial',
        'https://www.tiktok.com/@djdrewofficiall',
      ],
    },
    {
      '@type': 'Person',
      name: 'German Segura',
      jobTitle: 'Co-owner',
    },
  ],
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'FL',
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'City', name: 'Fort Lauderdale' },
    { '@type': 'AdministrativeArea', name: 'Broward County' },
    { '@type': 'AdministrativeArea', name: 'Palm Beach County' },
    { '@type': 'City', name: 'West Palm Beach' },
    { '@type': 'City', name: 'Boca Raton' },
    { '@type': 'City', name: 'Miami' },
    { '@type': 'City', name: 'Miami Beach' },
    { '@type': 'AdministrativeArea', name: 'Miami-Dade County' },
    { '@type': 'City', name: 'Wilton Manors' },
  ],
  priceRange: '$$',
  slogan: 'The Ultimate Wedding Experience',
  award: 'WeddingWire Best of Weddings',
  knowsLanguage: ['en', 'es'],
  knowsAbout: [
    'Wedding DJ',
    'Master of Ceremonies',
    'Bilingual MC (English and Spanish)',
    'Photo Booth Rental',
    'Uplighting',
    'Cold Sparks',
    'Dancing on the Clouds',
  ],
  sameAs: [
    'https://www.instagram.com/xpressdjs',
    'https://www.tiktok.com/@xpressdjs',
    'https://www.youtube.com/@xpressdjs',
    'https://www.facebook.com/xpressdjsfl',
    'https://www.zola.com/wedding-vendors/wedding-bands-djs/xpress-djs--2',
  ],
};
---
<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={Astro.url.href} />
  {hasES(enPath) && (
    <>
      <link rel="alternate" hreflang="en" href={altEn} />
      <link rel="alternate" hreflang="es" href={altEs} />
      <link rel="alternate" hreflang="x-default" href={altEn} />
    </>
  )}
  <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Montserrat:wght@400;500;600;700;800&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Montserrat:wght@400;500;600;700;800&display=swap" /></noscript>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)} />

  <!-- Unified event helper + phone/text click tracking. Safe no-op when no
       analytics tags are loaded, so the rest of the site can call track()
       unconditionally. Analytics scripts themselves are injected by
       src/scripts/consent-ui.js only after an explicit allow choice. -->
  <script is:inline>
    window.track = function (name, params) {
      try { if (window.gtag) window.gtag('event', name, params || {}); } catch (e) {}
      try { if (window.clarity) window.clarity('event', name); } catch (e) {}
    };
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href^="tel:"], a[href^="sms:"]');
      if (!a) return;
      var href = a.getAttribute('href') || '';
      window.track('contact_click', { method: href.indexOf('tel:') === 0 ? 'call' : 'text', link_url: href });
    }, true);
  </script>
</head>
<body>
  <a class="skip-link" href="#main">{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
  <script type="application/json" id="xe-consent-config" is:inline set:html={JSON.stringify(consentBoot)}></script>
  <Nav />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <LangToggle />
  <script>
    import { bootConsent } from '../scripts/consent-ui.js';
    bootConsent();
  </script>
  <script is:inline src="/js/main.js"></script>
</body>
</html>
