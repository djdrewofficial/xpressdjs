---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const {
  title,
  description,
  image = '/images/og-default.png',
} = Astro.props;
// Social scrapers need an absolute URL. Resolve relative paths against the
// site domain; pass-through any already-absolute URL.
const ogImage = image.startsWith('http') ? image : new URL(image, Astro.site ?? Astro.url).href;

// Site-wide LocalBusiness structured data (helps Google's local pack,
// knowledge panel, and rich results). Renders invisibly in <head>.
const SITE_ORIGIN = Astro.site ? Astro.site.origin : 'https://xpressdjs.com';
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'EntertainmentBusiness',
  '@id': `${SITE_ORIGIN}/#business`,
  name: 'Xpress Entertainment',
  legalName: 'Xpress Entertainment Corp.',
  alternateName: 'Xpress DJs',
  description: "South Florida's award-winning wedding DJ & entertainment company serving Miami, Fort Lauderdale, Palm Beach, and the Florida Keys.",
  url: `${SITE_ORIGIN}/`,
  telephone: '+1-954-233-0698',
  email: 'events@xpressdjs.com',
  logo: `${SITE_ORIGIN}/logo.svg`,
  image: `${SITE_ORIGIN}/images/og-default.png`,
  priceRange: '$$',
  slogan: 'The Ultimate Wedding Experience',
  award: 'WeddingWire Best of Weddings',
  knowsLanguage: ['en', 'es'],
  founder: { '@type': 'Person', name: 'Drew Segura' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Pembroke Pines',
    addressRegion: 'FL',
    addressCountry: 'US',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 26.0078, longitude: -80.2963 },
  areaServed: [
    { '@type': 'City', name: 'Miami' },
    { '@type': 'City', name: 'Fort Lauderdale' },
    { '@type': 'City', name: 'West Palm Beach' },
    { '@type': 'City', name: 'Miami Beach' },
    { '@type': 'City', name: 'Boca Raton' },
    { '@type': 'AdministrativeArea', name: 'The Florida Keys' },
  ],
  knowsAbout: ['Wedding DJ', 'Master of Ceremonies', 'Photo Booth Rental', 'Uplighting', 'Cold Sparks', 'Dancing on the Clouds', 'Bilingual DJ'],
  sameAs: ['https://www.instagram.com/xpressdjs'],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={Astro.url.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)} />
</head>
<body>
  <Nav />
  <slot />
  <Footer />
  <script is:inline src="/js/main.js"></script>
  <!-- GoHighLevel chat widget -->
  <script is:inline src="https://widgets.leadconnectorhq.com/loader.js" data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js" data-widget-id="67e471068265f49a8cbc5a50"></script>
</body>
</html>
