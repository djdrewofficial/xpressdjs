---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LangToggle from '../components/LangToggle.astro';
import { getLocale, toEnPath, hasES } from '../i18n/ui';

const {
  title,
  description,
  image = '/images/og-default.png',
  noindex = false,
  // A2P/SMS compliance: the GoHighLevel chat widget collects phone numbers &
  // SMS opt-in, so it must NOT appear on pages that already have a form
  // collecting phone numbers or SMS consent (lead, contact, or appointment
  // forms). Those pages set hideChat to suppress the widget.
  hideChat = false,
} = Astro.props;

const locale = getLocale(Astro.url);
const enPath = toEnPath(Astro.url.pathname);
// Social scrapers need an absolute URL. Resolve relative paths against the
// site domain; pass-through any already-absolute URL.
const ogImage = image.startsWith('http') ? image : new URL(image, Astro.site ?? Astro.url).href;

// Site-wide LocalBusiness structured data (helps Google's local pack,
// knowledge panel, and rich results). Renders invisibly in <head>.
const SITE_ORIGIN = Astro.site ? Astro.site.origin : 'https://xpressdjs.com';
const altEn = SITE_ORIGIN + enPath;
const altEs = SITE_ORIGIN + (enPath === '/' ? '/es/' : '/es' + enPath);

// Analytics. Clarity's project ID is a public client-side ID (it ships in the
// page source), so it's set as the default here and is live in every build.
// GA4's Measurement ID is likewise public but not set yet — add PUBLIC_GA4_ID
// in Cloudflare Pages → Environment variables to switch it on. Either can be
// overridden per-environment via the matching PUBLIC_* env var.
//   PUBLIC_GA4_ID      = G-XXXXXXXXXX   (Google Analytics 4 Measurement ID)
//   PUBLIC_CLARITY_ID  = xxxxxxxxxx     (Microsoft Clarity project ID)
const GA4_ID = import.meta.env.PUBLIC_GA4_ID || '';
const CLARITY_ID = import.meta.env.PUBLIC_CLARITY_ID || 'y4xq7tf2or';
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'EntertainmentBusiness',
  '@id': `${SITE_ORIGIN}/#business`,
  name: 'Xpress Entertainment',
  legalName: 'Xpress Entertainment Corp.',
  alternateName: 'Xpress DJs',
  description: "South Florida's award-winning wedding DJ & entertainment company serving Miami, Fort Lauderdale, Palm Beach, and the Florida Keys.",
  url: `${SITE_ORIGIN}/`,
  telephone: '+1-954-833-1196',
  email: 'events@xpressdjs.com',
  logo: `${SITE_ORIGIN}/logo.svg`,
  image: `${SITE_ORIGIN}/images/og-default.png`,
  priceRange: '$$',
  slogan: 'The Ultimate Wedding Experience',
  award: 'WeddingWire Best of Weddings',
  knowsLanguage: ['en', 'es'],
  founder: { '@type': 'Person', name: 'Drew Segura' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '11280 Pines Blvd',
    addressLocality: 'Pembroke Pines',
    addressRegion: 'FL',
    postalCode: '33026',
    addressCountry: 'US',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 26.0078, longitude: -80.2963 },
  areaServed: [
    { '@type': 'City', name: 'Miami' },
    { '@type': 'City', name: 'Fort Lauderdale' },
    { '@type': 'City', name: 'West Palm Beach' },
    { '@type': 'City', name: 'Miami Beach' },
    { '@type': 'City', name: 'Boca Raton' },
    { '@type': 'AdministrativeArea', name: 'The Florida Keys' },
  ],
  knowsAbout: ['Wedding DJ', 'Master of Ceremonies', 'Photo Booth Rental', 'Uplighting', 'Cold Sparks', 'Dancing on the Clouds', 'Bilingual DJ'],
  sameAs: ['https://www.instagram.com/xpressdjs'],
};
---
<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={Astro.url.href} />
  {hasES(enPath) && (
    <>
      <link rel="alternate" hreflang="en" href={altEn} />
      <link rel="alternate" hreflang="es" href={altEs} />
      <link rel="alternate" hreflang="x-default" href={altEn} />
    </>
  )}
  <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Montserrat:wght@400;500;600;700;800&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Montserrat:wght@400;500;600;700;800&display=swap" /></noscript>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)} />
  <!-- PromptWatch analytics -->
  <script is:inline>
    (function() {
      var script = document.createElement('script');
      script.setAttribute('data-project-id', '2ef09549-34fc-4564-9593-a86e232989cc');
      script.src = 'https://ingest.promptwatch.com/js/client.min.js';
      document.head.appendChild(script);
    })();
  </script>

  <!-- Google Analytics 4 (loads only when PUBLIC_GA4_ID is set) -->
  {GA4_ID && (
    <script is:inline define:vars={{ GA4_ID }}>
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA4_ID;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', GA4_ID);
    </script>
  )}

  <!-- Microsoft Clarity (loads only when PUBLIC_CLARITY_ID is set) -->
  {CLARITY_ID && (
    <script is:inline define:vars={{ CLARITY_ID }}>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", CLARITY_ID);
    </script>
  )}

  <!-- Unified event helper + phone/text click tracking. Safe no-op when no
       analytics tags are loaded, so the rest of the site can call track()
       unconditionally. -->
  <script is:inline>
    window.track = function (name, params) {
      try { if (window.gtag) window.gtag('event', name, params || {}); } catch (e) {}
      try { if (window.clarity) window.clarity('event', name); } catch (e) {}
    };
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href^="tel:"], a[href^="sms:"]');
      if (!a) return;
      var href = a.getAttribute('href') || '';
      window.track('contact_click', { method: href.indexOf('tel:') === 0 ? 'call' : 'text', link_url: href });
    }, true);
  </script>
</head>
<body>
  <Nav />
  <slot />
  <Footer />
  <LangToggle />
  <script is:inline src="/js/main.js"></script>
  <!-- GoHighLevel chat widget — deferred off the critical path (loads on first
       interaction, or 4s after load) so it doesn't slow LCP/first paint.
       Suppressed on pages that collect phone numbers / SMS opt-in (hideChat)
       to satisfy A2P/SMS carrier compliance. -->
  {!hideChat && (
    <script is:inline>
      (function () {
        var loaded = false;
        function loadChat() {
          if (loaded) return; loaded = true;
          var s = document.createElement('script');
          s.src = 'https://widgets.leadconnectorhq.com/loader.js';
          s.setAttribute('data-resources-url', 'https://widgets.leadconnectorhq.com/chat-widget/loader.js');
          s.setAttribute('data-widget-id', '6a4c5594af4e62471842d114');
          s.setAttribute('data-source', 'WEB_USER');
          document.body.appendChild(s);
        }
        ['scroll', 'mousemove', 'touchstart', 'click', 'keydown'].forEach(function (e) {
          window.addEventListener(e, loadChat, { once: true, passive: true });
        });
        if ('requestIdleCallback' in window) requestIdleCallback(loadChat, { timeout: 5000 });
        else window.addEventListener('load', function () { setTimeout(loadChat, 4000); });
      })();
    </script>
  )}
</body>
</html>
