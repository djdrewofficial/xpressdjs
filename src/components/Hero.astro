---
import fs from 'node:fs';
import Credit from './Credit.astro';
const {
  eyebrow,
  titleHtml,
  sub,
  image,
  alt = '',
  ctaText,
  ctaHref = '/check-availability',
  ctaText2,
  ctaHref2,
  size = 'tall',
  creditName,
  creditHref,
  imgFocus,
  titleStyle,
} = Astro.props;
const minh = size === 'full' ? '100svh' : size === 'mid' ? '62svh' : '78svh';
const isJpg = /\.jpe?g$/i.test(image);
const webpFullPath = isJpg ? image.replace(/\.jpe?g$/i, '.webp') : null;
const webpSmPath = isJpg ? image.replace(/\.jpe?g$/i, '-1280.webp') : null;
// Only advertise the webp <source> when BOTH derivatives actually exist on
// disk. Otherwise a webp-capable browser would select a 404 source and render
// a blank hero (the <img> fallback only applies when no <source> matches).
const hasWebp =
  isJpg && image.startsWith('/') &&
  fs.existsSync(`public${webpFullPath}`) && fs.existsSync(`public${webpSmPath}`);
const webpFull = hasWebp ? webpFullPath : null;
const webpSm = hasWebp ? webpSmPath : null;
const focusStyle = imgFocus ? `--hero-focus:${imgFocus}` : undefined;
---
<header class="hero" style={`min-height:${minh};`}>
  <div class="hero-bg">
    {webpFull ? (
      <picture>
        <source type="image/webp" srcset={`${webpSm} 1280w, ${webpFull} 2560w`} sizes="100vw" />
        <img src={image} alt={alt} fetchpriority="high" decoding="async" style={focusStyle} />
      </picture>
    ) : (
      <img src={image} alt={alt} fetchpriority="high" decoding="async" style={focusStyle} />
    )}
  </div>
  <Credit variant="overlay" name={creditName} href={creditHref} />
  <div class="wrap">
    {eyebrow && <span class="eyebrow light hero-in">{eyebrow}</span>}
    <h1 class="display hero-in" style={titleStyle} set:html={titleHtml}></h1>
    {sub && <p class="lead hero-in">{sub}</p>}
    {(ctaText || ctaText2) && (
      <div class="hero-cta hero-in">
        {ctaText && <a href={ctaHref} class="btn"><span>{ctaText}</span> <span class="arrow">↗</span></a>}
        {ctaText2 && <a href={ctaHref2} class="btn ghost"><span>{ctaText2}</span></a>}
      </div>
    )}
  </div>
</header>
