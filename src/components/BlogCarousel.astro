---
/*
  One blog category as a static, manual horizontal carousel: swipe on touch,
  prev/next arrows on desktop. No auto-motion. (Arrow scrolling is wired in
  /js/main.js.)
*/
const { title, posts = [], hrefBase = '/wedding-blog' } = Astro.props;
---
{posts.length > 0 && (
  <section class="blog-cat">
    <div class="wrap">
      <div class="blog-cat-head">
        <h2 class="h-lg blog-cat-title">{title}</h2>
        <div class="blog-nav">
          <button class="blog-arrow" type="button" data-dir="-1" aria-label="Previous">‹</button>
          <button class="blog-arrow" type="button" data-dir="1" aria-label="Next">›</button>
        </div>
      </div>
      <div class="blog-strip">
        <div class="blog-track">
          {posts.map((p) => (
            <a class="card blog-card" href={`${hrefBase}/${p.slug}`} aria-label={p.data.title}>
              <img src={p.data.image} alt={p.data.title} loading="lazy" decoding="async" />
              <span class="tag">{p.data.tag}</span>
              <div class="card-body"><h3 style="font-size:1.2rem;">{p.data.title}</h3></div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
