---
import { getLocale, toEnPath, localize, t } from '../i18n/ui';
const locale = getLocale(Astro.url);
const enPath = toEnPath(Astro.url.pathname);
const path = enPath;
const isActive = (href) => (href === '/' ? path === '/' : path.startsWith(href));
const L = (p) => localize(p, locale);
const n = t(locale).nav;
---
<nav class="nav">
  <a href={L('/')} class="brand" aria-label="Xpress Entertainment — home">
    <img class="brand-logo" src="/logo.svg" alt="Xpress Entertainment" width="150" height="62" />
  </a>
  <div class="nav-links">
    <a href={L('/the-experience')} class={isActive('/the-experience') ? 'active' : ''}>{n.experience}</a>

    <div class="nav-item">
      <a href={L('/services/djs')} class="dd-toggle">{n.djs} <span class="car">▾</span></a>
      <div class="dropdown"><div class="dropdown-inner">
        <a href={L('/dj-drew-segura')}>{n.djDrew}</a>
        <a href={L('/djatomic')}>{n.djAtomic}</a>
        <a href={L('/djphil')}>{n.djPhil}</a>
        <a href={L('/services/djs')}>{n.allDjs}</a>
      </div></div>
    </div>

    <div class="nav-item">
      <a href={L('/services')} class="dd-toggle">{n.services} <span class="car">▾</span></a>
      <div class="dropdown"><div class="dropdown-inner">
        <a href={L('/services')}>{n.allServices}</a>
        <a href={L('/south-florida-photo-booth-rental')}>{n.photoBooths}</a>
        <a href={L('/wedding-content-creator')}>{n.contentCreator}</a>
        <a href={L('/vibo')}>{n.vibo}</a>
      </div></div>
    </div>

    <div class="nav-item">
      <a href={L('/epic-extras-1')} class="dd-toggle">{n.epicExtras} <span class="car">▾</span></a>
      <div class="dropdown"><div class="dropdown-inner">
        <a href={L('/epic-extras-1')}>{n.overview}</a>
        <a href={L('/epic-extras-1/dancing-on-the-clouds')}>{n.clouds}</a>
        <a href={L('/epic-extras-1/cold-sparks')}>{n.coldSparks}</a>
        <a href={L('/epic-extras-1/lighting')}>{n.lighting}</a>
      </div></div>
    </div>

    <a href={L('/pricing')} class={isActive('/pricing') ? 'active' : ''}>{n.pricing}</a>
    <a href={L('/wedding-blog')} class={isActive('/wedding-blog') ? 'active' : ''}>{n.blog}</a>
    <a href={L('/about-xpress-entertainment')} class={isActive('/about-xpress-entertainment') ? 'active' : ''}>{n.about}</a>
    <a href={L('/check-availability')} class="btn"><span>{n.checkDate}</span></a>
  </div>
  <button class="burger" aria-label="Menu"><span></span><span></span><span></span></button>
</nav>
