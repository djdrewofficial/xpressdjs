---
/*
  "Follow the DJ" section — branded social links beside featured reels.

  Props:
    name     DJ display name, e.g. 'Drew Segura'
    eyebrow  small kicker (default 'Stay connected')
    links    [{ platform, url, handle? }]  platform in:
             instagram | youtube | tiktok | soundcloud | mixcloud
    reels    optional [{ url, cover, handle }] — custom dark cards that
             open the Instagram reel on click. We self-host the cover image
             (Instagram's own embed forces a white card we can't restyle).
*/
import { getLocale } from '../i18n/ui';
interface Link { platform: string; url: string; handle?: string; }
interface Reel { url: string; cover: string; handle?: string; }
interface Props { name: string; eyebrow?: string; links: Link[]; reels?: Reel[]; }
const { name, eyebrow, links, reels = [] } = Astro.props;
const locale = getLocale(Astro.url);
const eb = eyebrow || (locale === 'es' ? 'Mantente conectado' : 'Stay connected');
const heading = locale === 'es' ? `Sigue a ${name}.` : `Follow ${name}.`;

const icons: Record<string, string> = {
  instagram: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z',
  youtube: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  tiktok: 'M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z',
  soundcloud: 'M10 20h4V4h-4v16zm-6 0h4v-8H4v8zM16 9v11h4V9h-4z',
  mixcloud: 'M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z',
  facebook: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
};
const labels: Record<string, string> = {
  instagram: 'Instagram', youtube: 'YouTube', tiktok: 'TikTok',
  soundcloud: 'SoundCloud', mixcloud: 'Mixcloud', facebook: 'Facebook',
};
const hasReels = reels.length > 0;
---
<section class="pad bg-deep">
  <div class="wrap">
    <div class="sec-head center reveal"><span class="eyebrow light">{eb}</span><h2 class="h-xl">{heading}</h2></div>
    <div class={`social-grid${hasReels ? '' : ' no-embeds'}`}>
      <div class="social-links reveal">
        {links.map((l) => (
          <a class="social-pill" data-p={l.platform} href={l.url} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icons[l.platform]} /></svg>
            <span class="sp-label">{labels[l.platform] || l.platform}</span>
            {l.handle && <span class="sp-handle">{l.handle}</span>}
            <span class="sp-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      {hasReels && (
        <div class="reel-grid reveal d1">
          {reels.map((r) => (
            <a class="reel-card" href={r.url} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${r.handle || name} on Instagram`}>
              <img src={r.cover} alt={`${r.handle || name} Instagram reel`} loading="lazy" decoding="async" />
              <span class="reel-shade" aria-hidden="true"></span>
              <span class="reel-top" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d={icons.instagram} /></svg>
                {r.handle && <span>{r.handle}</span>}
              </span>
              <span class="reel-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
              <span class="reel-bottom" aria-hidden="true"><span class="reel-watch">Watch reel</span><span class="reel-arrow">↗</span></span>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
