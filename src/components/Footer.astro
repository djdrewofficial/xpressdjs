---
import { getLocale, localize, t } from '../i18n/ui';
const locale = getLocale(Astro.url);
const L = (p) => localize(p, locale);
const f = t(locale).foot;
---
<footer>
  <div class="foot-grid">
    <div class="foot-col">
      <img class="brand-logo foot-logo" src="/logo.svg" alt="Xpress Entertainment" width="180" height="74" />
      <p style="color:var(--muted); max-width:34ch;">{f.tagline}</p>
    </div>
    <div class="foot-col">
      <h5>{f.explore}</h5>
      <a href={L('/')}>{f.home}</a>
      <a href={L('/the-experience')}>{f.theExperience}</a>
      <a href={L('/services')}>{f.services}</a>
      <a href={L('/pricing')}>{f.pricing}</a>
      <a href={L('/wedding-blog')}>{f.weddingBlog}</a>
      <a href={L('/about-xpress-entertainment')}>{f.about}</a>
    </div>
    <div class="foot-col">
      <h5>{f.servicesHead}</h5>
      <a href={L('/services/djs')}>{f.weddingDjs}</a>
      <a href={L('/services/av-rentals')}>{f.avRentals}</a>
      <a href={L('/south-florida-photo-booth-rental')}>{f.photoBooths}</a>
      <a href={L('/epic-extras-1')}>{f.epicExtras}</a>
      <a href={L('/wedding-content-creator')}>{f.contentCreator}</a>
      <a href={L('/vibo')}>{f.viboPlanning}</a>
    </div>
    <div class="foot-col">
      <h5>{f.contact}</h5>
      <address class="foot-address">
        Xpress Entertainment Corp<br />
        11280 Pines Blvd<br />
        Pembroke Pines, FL 33026
      </address>
      <a href="tel:9548331196">954·833·1196</a>
      <a href="mailto:events@xpressdjs.com">events@xpressdjs.com</a>
      <a href={L('/check-availability')}>{f.checkAvailability}</a>
      <a href="https://www.instagram.com/xpressdjs" target="_blank" rel="noopener">Instagram</a>
    </div>
  </div>
  <div class="foot-welcome-row">
    <a href="/lgbtq-wedding-dj-south-florida" aria-label="LGBTQ wedding DJ in South Florida, all are welcome here">
      <img class="foot-welcome" src="/images/all-are-welcome-here-badge.png" alt="All are welcome here — Xpress Entertainment is a proud, inclusive wedding vendor that warmly serves all LGBTQ couples." width="200" height="44" loading="lazy" />
    </a>
  </div>
  <div class="foot-bottom">
    <span>© <span data-year>2026</span> Xpress Entertainment Corp. {f.rightsSuffix}</span>
    <span class="foot-legal">
      <a href={L('/privacy-policy')}>{f.privacy}</a>
      <a href={L('/terms-of-service')}>{f.terms}</a>
    </span>
    <span>{f.tagline2}</span>
  </div>
</footer>
